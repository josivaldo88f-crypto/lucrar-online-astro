---
import Relacionados from '../components/Relacionados.astro';

interface Props {
	title?: string;
	description?: string;
	categoria?: string;
	showRelacionados?: boolean;
}

const { 
	title = "Lucrar Online - Seu Guia para Renda Extra na Internet", 
	description = "Aprenda a lucrar online com dicas de apps e sites para ganhar dinheiro e estratégias comprovadas",
	categoria = "geral",
	showRelacionados = true
} = Astro.props;

// Mapeia categoria → nome amigável e URL do link de navegação
const categoriaMap: Record<string, { nome: string; navUrl: string }> = {
	home: { nome: "Início", navUrl: "/" },
	noticias: { nome: "Notícias", navUrl: "/noticias/" },
	futebol: { nome: "Futebol", navUrl: "/futebol/" },
	comprar: { nome: "Comprar", navUrl: "/comprar/" },
	"GANHAR DINHEIRO": { nome: "Ganhar Dinheiro", navUrl: "/ganhar-dinheiro/" },
	ferramentas: { nome: "Ferramentas", navUrl: "/ferramentas/" },
	blog: { nome: "Blog", navUrl: "/blog/" },
	post: { nome: "Blog", navUrl: "/blog/" },
	relacionamento: { nome: "Relacionamento", navUrl: "" },
	geral: { nome: "Lucrar Online", navUrl: "" },
};

const catInfo = categoriaMap[categoria] || categoriaMap["geral"];
const nomeCategoria = catInfo.nome;
const navAtivo = catInfo.navUrl;

// Título da aba: só mostra a categoria e o título, sem "Lucrar Online"
const tituloAba = categoria === "home" 
	? "Lucrar Online - Seu Guia para Renda Extra na Internet"
	: title === nomeCategoria ? nomeCategoria : `${nomeCategoria} | ${title}`;

let canonicalPathname = Astro.url.pathname;
if (canonicalPathname.endsWith('.html')) canonicalPathname = canonicalPathname.slice(0, -5);
if (canonicalPathname !== '/' && !canonicalPathname.endsWith('/')) canonicalPathname += '/';
const canonicalURL = new URL(canonicalPathname, Astro.site ?? 'https://www.lucrar.link/').href;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="keywords" content="lucrar online, renda extra, app para ganhar dinheiro" />
		<title>{tituloAba}</title>
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="stylesheet" href="/styles.css" />
		<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-7225X73JRY"></script>
		<script type="text/partytown" is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-7225X73JRY');
		</script>
		<style is:global>
			/* Importando estilos globais se necessário */
            .youtube-btn {
                background-color: #FF0000;
                color: white !important;
                padding: 0.5rem 1rem;
                border-radius: 20px;
                font-weight: bold;
                transition: transform 0.2s, background-color 0.2s;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }
            .youtube-btn:hover {
                background-color: #cc0000;
                transform: scale(1.05);
                text-decoration: none;
            }

			/* Destaque do link ativo na navegação */
			.nav-link.active {
				color: #6366f1 !important;
				font-weight: 700;
				position: relative;
			}
			.nav-link.active::after {
				content: '';
				position: absolute;
				bottom: -4px;
				left: 50%;
				transform: translateX(-50%);
				width: 60%;
				height: 3px;
				background: linear-gradient(90deg, #6366f1, #8b5cf6);
				border-radius: 2px;
			}
			.youtube-btn.active {
				color: white !important;
			}
			.youtube-btn.active::after {
				background: white;
			}
		</style>
	</head>
	<body>
		<header class="header">
			<div class="container">
				<h1 class="logo"><a href="/" style="text-decoration: none; color: inherit;">{categoria === "home" ? "Lucrar Online" : nomeCategoria}</a></h1>
				<nav class="nav">
					<ul class="nav-list">
						<li><a href="/" class={`nav-link ${navAtivo === '/' ? 'active' : ''}`}>Início</a></li>
						<li><a href="/noticias/" class={`nav-link ${navAtivo === '/noticias/' ? 'active' : ''}`}>Notícias</a></li>
						<li class="nav-hidden"><a href="/futebol/" class={`nav-link ${navAtivo === '/futebol/' ? 'active' : ''}`}>Futebol</a></li>
						<li><a href="/comprar/" class={`nav-link ${navAtivo === '/comprar/' ? 'active' : ''}`}>Comprar</a></li>
						<li><a href="/ganhar-dinheiro/" class={`nav-link ${navAtivo === '/ganhar-dinheiro/' ? 'active' : ''}`}>Ganhar Dinheiro</a></li>
						<li class="nav-hidden"><a href="/ferramentas/" class={`nav-link ${navAtivo === '/ferramentas/' ? 'active' : ''}`}>Ferramentas</a></li>
						<li class="nav-hidden"><a href="/blog/" class={`nav-link ${navAtivo === '/blog/' ? 'active' : ''}`}>Blog</a></li>
						<li class="nav-more-item">
							<button class="nav-more-btn" aria-label="Mostrar mais categorias">
								<span class="nav-more-text">Mais</span>
								<span class="nav-more-arrow">▼</span>
							</button>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<main class="main">
			<div class="container">
				<slot />
				{showRelacionados && <Relacionados categoria={categoria} />}
			</div>
		</main>

		<footer class="footer">
			<div class="container">
				<p>&copy; {new Date().getFullYear()} Lucrar Online. Todos os direitos reservados.</p>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const pathname = window.location.pathname;
				const shouldAddTrailingSlash = pathname !== '/' && !pathname.endsWith('/') && !pathname.includes('.');
				if (shouldAddTrailingSlash) {
					window.location.replace(pathname + '/' + window.location.search + window.location.hash);
					return;
				}

				// Alterna o texto do botao "Mais" / "Menos"
				const moreBtn = document.querySelector('.nav-more-btn');
				const navList = document.querySelector('.nav-list');
				const nav = document.querySelector('.nav');
				
				if (moreBtn && navList && nav) {
					moreBtn.addEventListener('click', function() {
						navList.classList.toggle('expanded');
						nav.classList.toggle('expanded');
						const isExpanded = navList.classList.contains('expanded');
						moreBtn.querySelector('.nav-more-text').textContent = isExpanded ? 'Menos' : 'Mais';
						moreBtn.setAttribute('aria-label', isExpanded ? 'Mostrar menos categorias' : 'Mostrar mais categorias');
					});
				}
			});
		</script>
	</body>
</html>
