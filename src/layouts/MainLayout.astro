---
import Relacionados from '../components/Relacionados.astro';
import type { SeoMetadata } from '../types/seo';
import '../styles/global.css';

interface Props {
	seo?: SeoMetadata;
	categoria?: string;
	showRelacionados?: boolean;
	preloadImage?: string;
	preloadImageSrcset?: string;
	preloadImageSizes?: string;
	lang?: 'pt-BR' | 'en';
	alternates?: { hreflang: string; href: string }[];
}

const { 
	seo = {
		title: "Seu Guia para Renda Extra na Internet",
		description: "Aprenda a lucrar online com dicas de apps e sites para ganhar dinheiro e estratégias comprovadas"
	},
	categoria = "geral",
	showRelacionados = true,
	preloadImage,
	preloadImageSrcset,
	preloadImageSizes,
	lang = 'pt-BR',
	alternates = []
} = Astro.props;

const isEn = lang === 'en';
const htmlLang = isEn ? 'en' : 'pt-BR';
const ogLocale = isEn ? 'en_US' : 'pt_BR';
const ogLocaleAlternate = isEn ? 'pt_BR' : 'en_US';

const {
	title,
	headline,
	description,
	image = "/images/default-post.webp",
	imageWidth = 1200,
	imageHeight = 630,
	datePublished,
	dateModified,
	noindex = false,
	faq
} = seo;

const categoriaMap: Record<string, { nome: string; nomeEn: string; navUrl: string }> = {
	home: { nome: "Início", nomeEn: "Home", navUrl: "/" },
	noticias: { nome: "Notícias", nomeEn: "News", navUrl: "/noticias/" },
	futebol: { nome: "Futebol", nomeEn: "Football", navUrl: "/futebol/" },
	comprar: { nome: "Comprar", nomeEn: "Shopping", navUrl: "/comprar/" },
	"GANHAR DINHEIRO": { nome: "Ganhar Dinheiro", nomeEn: "Make Money Online", navUrl: "/ganhar-dinheiro/" },
	ferramentas: { nome: "Ferramentas", nomeEn: "Tools", navUrl: "/ferramentas/" },
	blog: { nome: "Blog", nomeEn: "Blog", navUrl: "/post/" },
	post: { nome: "Blog", nomeEn: "Blog", navUrl: "/post/" },
	relacionamento: { nome: "Relacionamento", nomeEn: "Relationships", navUrl: "/relacionamento/" },
	geral: { nome: "Lucrar Online", nomeEn: "Lucrar Online", navUrl: "/" },
};

const catInfo = categoriaMap[categoria] || categoriaMap["geral"];
const nomeCategoria = isEn ? catInfo.nomeEn : catInfo.nome;
const navAtivo = catInfo.navUrl;

const labels = isEn
	? {
		skip: "Skip to content",
		navAria: "Main navigation",
		home: "Home",
		searchLabel: "Search the site",
		searchPlaceholder: "Search",
		searchButton: "Search",
		menuOpen: "Open menu",
		menuClose: "Close menu",
		mobileNavAria: "Mobile navigation",
		breadcrumbAria: "Breadcrumb",
		notice: "campaigns, tasks, minimum amounts and withdrawal methods can change without notice. Earnings vary by user and are not guaranteed. Check the current rules in the app before taking part.",
		footerDescription: "Guides, reviews and news for anyone looking for extra income online, with clear, up-to-date and responsible information.",
		categoriesTitle: "Categories",
		guidesTitle: "Guides",
		aboutTitle: "About",
		guidePix: "Apps that pay via Pix",
		guideSurveys: "Paid survey sites",
		guideInterest: "Compound interest",
		guideHeadphones: "Affordable headphones",
		aboutBlog: "Blog",
		aboutRelationships: "Relationships",
		aboutSearch: "Search",
		rights: "All rights reserved.",
	}
	: {
		skip: "Pular para o conteúdo",
		navAria: "Navegação principal",
		home: "Início",
		searchLabel: "Pesquisar no site",
		searchPlaceholder: "Pesquisar",
		searchButton: "Buscar",
		menuOpen: "Abrir menu",
		menuClose: "Fechar menu",
		mobileNavAria: "Navegação móvel",
		breadcrumbAria: "Breadcrumb",
		notice: "campanhas, tarefas, valores mínimos e formas de saque podem mudar sem aviso. Ganhos variam por usuário e não são garantidos. Confira as regras atuais no aplicativo antes de participar.",
		footerDescription: "Guias, análises e notícias para quem busca renda extra na internet com informação clara, atualizada e responsável.",
		categoriesTitle: "Categorias",
		guidesTitle: "Guias",
		aboutTitle: "Sobre",
		guidePix: "Apps que pagam no Pix",
		guideSurveys: "Sites de pesquisas",
		guideInterest: "Juros compostos",
		guideHeadphones: "Fones de ouvido",
		aboutBlog: "Blog",
		aboutRelationships: "Relacionamento",
		aboutSearch: "Pesquisar",
		rights: "Todos os direitos reservados.",
	};

const primaryNav = ["home", "noticias", "futebol", "comprar", "GANHAR DINHEIRO", "ferramentas"];
const mobileNav = [...primaryNav, "post"];

const tituloAba = title.replace(/\s*(?:-|\|)\s*Lucrar Online\s*$/i, '').trim();

let canonicalPathname = Astro.url.pathname;
if (canonicalPathname.endsWith('.html')) canonicalPathname = canonicalPathname.slice(0, -5);
if (canonicalPathname !== '/' && !canonicalPathname.endsWith('/')) canonicalPathname += '/';
const canonicalURL = new URL(canonicalPathname, Astro.site ?? 'https://www.lucrar.link/').href;
const socialImageURL = new URL(image, Astro.site ?? 'https://www.lucrar.link/').href;
const isArticle = Boolean(datePublished);
const articleType = categoria === "noticias" ? "NewsArticle" : "BlogPosting";
const isCategoryPage = !isArticle && categoria !== "home" && categoria !== "geral" && canonicalPathname === catInfo.navUrl;

const siteGraphJson = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": "https://www.lucrar.link/#organization",
			"name": "Lucrar Online",
			"url": "https://www.lucrar.link/",
			"logo": {
				"@type": "ImageObject",
				"url": "https://www.lucrar.link/images/favicon-lucrar.link.png",
				"width": 320,
				"height": 320
			}
		},
		{
			"@type": "WebSite",
			"@id": "https://www.lucrar.link/#website",
			"name": "Lucrar Online",
			"url": "https://www.lucrar.link/",
			"description": isEn ? "Your guide to extra income online" : "Seu guia para renda extra na internet",
			"inLanguage": htmlLang,
			"publisher": {
				"@id": "https://www.lucrar.link/#organization"
			},
			"potentialAction": {
				"@type": "SearchAction",
				"target": {
					"@type": "EntryPoint",
					"urlTemplate": "https://www.lucrar.link/buscar/?q={search_term_string}"
				},
				"query-input": "required name=search_term_string"
			}
		}
	]
});

const articleJson = isArticle ? JSON.stringify({
	"@context": "https://schema.org",
	"@type": articleType,
	"headline": headline ?? title,
	"description": description,
	"image": [socialImageURL],
	"datePublished": datePublished,
	...(dateModified ? { "dateModified": dateModified } : {}),
	"inLanguage": htmlLang,
	"isAccessibleForFree": true,
	"articleSection": nomeCategoria,
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": canonicalURL
	},
	"author": {
		"@type": "Organization",
		"name": "Lucrar Online",
		"url": "https://www.lucrar.link/"
	},
	"publisher": {
		"@type": "Organization",
		"name": "Lucrar Online",
		"url": "https://www.lucrar.link/",
		"logo": {
			"@type": "ImageObject",
			"url": "https://www.lucrar.link/images/favicon-lucrar.link.png"
		}
	}
}) : null;

const collectionJson = isCategoryPage ? JSON.stringify({
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": tituloAba,
	"description": description,
	"url": canonicalURL,
	"inLanguage": htmlLang,
	"isPartOf": {
		"@id": "https://www.lucrar.link/#website"
	},
	"publisher": {
		"@id": "https://www.lucrar.link/#organization"
	}
}) : null;

const faqJson = faq && faq.length > 0 ? JSON.stringify({
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faq.map((item) => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
}) : null;

const breadcrumbItems = [
	{
		"@type": "ListItem",
		"position": 1,
		"name": labels.home,
		"item": "https://www.lucrar.link/"
	},
	{
		"@type": "ListItem",
		"position": 2,
		"name": nomeCategoria,
		"item": isArticle
			? new URL(catInfo.navUrl, Astro.site ?? "https://www.lucrar.link/").href
			: canonicalURL
	}
];

if (isArticle) {
	breadcrumbItems.push({
		"@type": "ListItem",
		"position": 3,
		"name": headline ?? title,
		"item": canonicalURL
	});
}

const breadcrumbJson = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbItems
});
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		<meta name="description" content={description} />
		<meta name="keywords" content={isEn ? "does dramaspot pay, dramaspot review, make money online, reward apps" : "lucrar online, renda extra, app para ganhar dinheiro"} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
		<meta name="author" content="Lucrar Online" />
		<meta name="theme-color" content="#2563eb" />
		<meta property="og:type" content={isArticle ? "article" : "website"} />
		<meta property="og:title" content={tituloAba} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Lucrar Online" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content={String(imageWidth)} />
		<meta property="og:image:height" content={String(imageHeight)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={tituloAba} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={title} />
		<title>{tituloAba}</title>
		<link rel="canonical" href={canonicalURL} />
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
		))}
		{preloadImageSrcset
			? <link rel="preload" as="image" imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />
			: preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script type="application/ld+json" set:html={siteGraphJson}></script>
		{categoria !== "home" && categoria !== "geral" && (
			<script type="application/ld+json" set:html={breadcrumbJson}></script>
		)}
		{collectionJson && <script type="application/ld+json" set:html={collectionJson}></script>}
		{articleJson && <script type="application/ld+json" set:html={articleJson}></script>}
		{faqJson && <script type="application/ld+json" set:html={faqJson}></script>}
		<slot name="head" />
		<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-7225X73JRY"></script>
		<script type="text/partytown" is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag('js', new Date());
				gtag('config', 'G-7225X73JRY');
		</script>
	</head>
	<body class={categoria === "home" ? "is-home" : "is-inner"}>
		<a class="skip-link" href="#conteudo">{labels.skip}</a>

		<header class="header" id="site-header">
			<div class="container header-inner">
				<a class="logo" href="/">
					<span class="logo-mark" aria-hidden="true">L</span>
					<span class="logo-text">{categoria === "home" ? "Lucrar Online" : nomeCategoria}</span>
				</a>
				<nav class="nav" aria-label={labels.navAria}>
					<ul class="nav-list">
						{primaryNav.map((key) => {
							const item = categoriaMap[key];
							const label = isEn ? item.nomeEn : item.nome;
							return (
								<li><a href={item.navUrl} class={`nav-link ${navAtivo === item.navUrl ? 'active' : ''}`} aria-current={navAtivo === item.navUrl ? 'page' : undefined}>{label}</a></li>
							);
						})}
					</ul>
				</nav>
				<form class="header-search" action="/buscar/" method="get" role="search">
					<label class="sr-only" for="header-search-input">{labels.searchLabel}</label>
					<input id="header-search-input" name="q" type="search" placeholder={labels.searchPlaceholder} required />
					<button type="submit" aria-label={labels.searchButton} formnovalidate>{labels.searchButton}</button>
				</form>
				<button class="menu-toggle" type="button" aria-label={labels.menuOpen} data-open-label={labels.menuOpen} data-close-label={labels.menuClose} aria-expanded="false" aria-controls="mobile-menu">
					<span class="menu-toggle-bar" aria-hidden="true"></span>
					<span class="menu-toggle-bar" aria-hidden="true"></span>
					<span class="menu-toggle-bar" aria-hidden="true"></span>
				</button>
			</div>
			<div class="mobile-menu" id="mobile-menu">
				<nav class="mobile-nav" aria-label={labels.mobileNavAria}>
					<ul class="mobile-nav-list">
						{mobileNav.map((key) => {
							const item = categoriaMap[key];
							const label = isEn ? item.nomeEn : item.nome;
							return (
								<li><a href={item.navUrl} class={`mobile-nav-link ${navAtivo === item.navUrl ? 'active' : ''}`} aria-current={navAtivo === item.navUrl ? 'page' : undefined}>{label}</a></li>
							);
						})}
					</ul>
				</nav>
				<form class="mobile-search" action="/buscar/" method="get" role="search">
					<label class="sr-only" for="mobile-search-input">{labels.searchLabel}</label>
					<input id="mobile-search-input" name="q" type="search" placeholder={labels.searchLabel} required />
					<button type="submit" aria-label={labels.searchButton} formnovalidate>{labels.searchButton}</button>
				</form>
			</div>
		</header>

		<main class="main" id="conteudo" tabindex="-1">
			<div class="container">
				{categoria !== "home" && categoria !== "geral" && (
					<nav class="breadcrumb" aria-label={labels.breadcrumbAria}>
						<ol class="breadcrumb-list">
							<li class="breadcrumb-item"><a href="/">{labels.home}</a></li>
							{isArticle && (
								<li class="breadcrumb-item"><a href={catInfo.navUrl}>{nomeCategoria}</a></li>
							)}
							<li class="breadcrumb-item breadcrumb-current" aria-current="page">{isArticle ? (headline ?? title) : nomeCategoria}</li>
						</ol>
					</nav>
				)}
				<slot />
				{isArticle && categoria === "GANHAR DINHEIRO" && (
					<aside class="earnings-disclaimer" aria-label={isEn ? "Reward notice" : "Aviso sobre recompensas"}>
						<strong>{isEn ? "Notice:" : "Aviso:"}</strong> {labels.notice}
					</aside>
				)}
				{showRelacionados && <Relacionados categoria={categoria} lang={lang} />}
			</div>
		</main>

		<footer class="footer">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-brand">
						<a class="footer-logo" href="/">
							<span class="logo-mark" aria-hidden="true">L</span>
							<span>Lucrar Online</span>
						</a>
						<p class="footer-description">{labels.footerDescription}</p>
					</div>
					<nav class="footer-column" aria-labelledby="footer-categorias">
						<h2 class="footer-title" id="footer-categorias">{labels.categoriesTitle}</h2>
						<ul class="footer-links">
							<li><a href="/ganhar-dinheiro/">{isEn ? categoriaMap["GANHAR DINHEIRO"].nomeEn : categoriaMap["GANHAR DINHEIRO"].nome}</a></li>
							<li><a href="/noticias/">{isEn ? categoriaMap["noticias"].nomeEn : categoriaMap["noticias"].nome}</a></li>
							<li><a href="/futebol/">{isEn ? categoriaMap["futebol"].nomeEn : categoriaMap["futebol"].nome}</a></li>
							<li><a href="/comprar/">{isEn ? categoriaMap["comprar"].nomeEn : categoriaMap["comprar"].nome}</a></li>
							<li><a href="/ferramentas/">{isEn ? categoriaMap["ferramentas"].nomeEn : categoriaMap["ferramentas"].nome}</a></li>
						</ul>
					</nav>
					<nav class="footer-column" aria-labelledby="footer-guias">
						<h2 class="footer-title" id="footer-guias">{labels.guidesTitle}</h2>
						<ul class="footer-links">
							<li><a href="/ganhar-dinheiro/top-3-apps-que-pagam-no-pix/">{labels.guidePix}</a></li>
							<li><a href="/sites-para-ganhar-dinheiro-respondendo-pesquisas/">{labels.guideSurveys}</a></li>
							<li><a href="/ferramentas/calculadora-de-juros-compostos/">{labels.guideInterest}</a></li>
							<li><a href="/comprar/melhores-fones-de-ouvido-baratos/">{labels.guideHeadphones}</a></li>
						</ul>
					</nav>
					<nav class="footer-column" aria-labelledby="footer-sobre">
						<h2 class="footer-title" id="footer-sobre">{labels.aboutTitle}</h2>
						<ul class="footer-links">
							<li><a href="/">{labels.home}</a></li>
							<li><a href="/post/">{labels.aboutBlog}</a></li>
							<li><a href="/relacionamento/">{labels.aboutRelationships}</a></li>
							<li><a href="/buscar/">{labels.aboutSearch}</a></li>
						</ul>
					</nav>
				</div>
				<div class="footer-bottom">
					<p>&copy; {new Date().getFullYear()} Lucrar Online. {labels.rights}</p>
				</div>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const pathname = window.location.pathname;
				const shouldAddTrailingSlash = pathname !== '/' && !pathname.endsWith('/') && !pathname.includes('.');
				if (shouldAddTrailingSlash) {
					window.location.replace(pathname + '/' + window.location.search + window.location.hash);
					return;
				}

				const menuToggle = document.querySelector('.menu-toggle');
				const mobileMenu = document.querySelector('.mobile-menu');
				const header = document.querySelector('.header');

				if (menuToggle && mobileMenu && header) {
					const closeMenu = function() {
						menuToggle.classList.remove('open');
						mobileMenu.classList.remove('open');
						document.body.classList.remove('menu-open');
						menuToggle.setAttribute('aria-expanded', 'false');
						menuToggle.setAttribute('aria-label', menuToggle.dataset.openLabel || (document.documentElement.lang === 'en' ? 'Open menu' : 'Abrir menu'));
					};

					const openMenu = function() {
						menuToggle.classList.add('open');
						mobileMenu.classList.add('open');
						document.body.classList.add('menu-open');
						menuToggle.setAttribute('aria-expanded', 'true');
						menuToggle.setAttribute('aria-label', menuToggle.dataset.closeLabel || (document.documentElement.lang === 'en' ? 'Close menu' : 'Fechar menu'));
					};

					menuToggle.addEventListener('click', function(event) {
						event.stopPropagation();
						if (menuToggle.classList.contains('open')) {
							closeMenu();
						} else {
							openMenu();
						}
					});

					mobileMenu.querySelectorAll('a').forEach(function(link) {
						link.addEventListener('click', closeMenu);
					});

					document.addEventListener('click', function(event) {
						if (!mobileMenu.classList.contains('open')) return;
						if (header.contains(event.target)) return;
						closeMenu();
					});

					document.addEventListener('keydown', function(event) {
						if (event.key === 'Escape' && mobileMenu.classList.contains('open')) {
							closeMenu();
							menuToggle.focus();
						}
					});

					const desktopQuery = window.matchMedia('(min-width: 769px)');
					const handleDesktopChange = function(event) {
						if (event.matches) closeMenu();
					};
					if (desktopQuery.addEventListener) {
						desktopQuery.addEventListener('change', handleDesktopChange);
					} else if (desktopQuery.addListener) {
						desktopQuery.addListener(handleDesktopChange);
					}
				}

				if (header) {
					const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
					updateHeader();
					window.addEventListener('scroll', updateHeader, { passive: true });
				}
			});
		</script>
	</body>
</html>

<style>
	.breadcrumb {
		margin: 0 0 1.25rem;
		font-size: 0.875rem;
	}

	.breadcrumb-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--muted);
	}

	.breadcrumb-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.breadcrumb-item + .breadcrumb-item::before {
		content: "›";
		color: var(--muted);
	}

	.breadcrumb-list a {
		color: var(--primary-dark);
		text-decoration: none;
	}

	.breadcrumb-list a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.breadcrumb-current {
		color: var(--muted);
	}
</style>
