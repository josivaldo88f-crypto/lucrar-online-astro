---
import { cardImage } from '../utils/image';

interface Props {
  title: string;
  description: string;
  url: string;
  image: string;
  date?: string;
  priority?: boolean;
}

const { title, description, url, image, date, priority = false } = Astro.props;

const formatDate = (value: string) => {
    const [year, month, day] = value.split('-').map(Number);

    return new Intl.DateTimeFormat('pt-BR', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(Date.UTC(year, month - 1, day)));
};
---

<article class="post-card">
    <div class="post-image">
        <img src={cardImage(image)} alt={title} width="600" height="375" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
    </div>
    <div class="post-content">
        <h2 class="post-title">{title}</h2>
        {date && <time class="post-date" datetime={date}>{formatDate(date)}</time>}
        <p class="post-excerpt">{description}</p>
        
        <a href={url} class="main-card-link" aria-label={`Ler mais sobre ${title}`}>
            <span class="visual-button">Ler mais</span>
        </a>
    </div>
</article>
