---
import { cardImage } from '../utils/image';
import { allPosts as postMeta } from '../utils/posts';

const { categoria, lang = 'pt-BR' } = Astro.props;
const isEn = lang === 'en';
const currentPath = Astro.url.pathname;

const normalizePath = (path: string) => {
    if (!path) return '';
    if (path === '/') return '/';
    return path.endsWith('/') ? path.slice(0, -1) : path;
};

const relacionados = postMeta.filter(post => {
    const postTitle = post.title;
    const postCategoria = post.categoria;
    const isSameCategory = String(postCategoria ?? '').toLowerCase() === String(categoria ?? '').toLowerCase();
    const isNotCurrent = normalizePath(post.url) !== normalizePath(currentPath);
    const isNotIndex = post.url && !post.isIndex;
    const isSameLang = post.locale === 'en' ? isEn : !isEn;
    return isSameCategory && isSameLang && isNotCurrent && postTitle && isNotIndex;
}).slice(0, 12);
---

{relacionados.length > 0 && (
    <section class="relacionados-section">
        <h2 class="relacionados-title">{isEn ? 'See also' : 'Veja também'}</h2>
        <div class="relacionados-grid" id="relacionados-container">
            {relacionados.map((post) => (
                <article class="relacionado-card" style="display: none;">
                    <div class="relacionado-image">
                        <img src={cardImage(post.image || '/images/default-post.webp')} alt={post.title} width="400" height="250" loading="lazy" decoding="async" />
                    </div>
                    <div class="relacionado-content">
                        <h3 class="relacionado-title-item">{post.title}</h3>
                        <a href={post.url} class="relacionado-link" aria-label={isEn ? `Read more about ${post.title}` : `Ler mais sobre ${post.title}`}></a>
                    </div>
                </article>
            ))}
        </div>
    </section>
)}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('relacionados-container');
        if (container) {
            const items = Array.from(container.querySelectorAll('.relacionado-card')) as HTMLElement[];
            if (items.length > 0) {
                const shuffled = items.sort(() => 0.5 - Math.random());
                shuffled.slice(0, 3).forEach(item => {
                    item.style.display = 'flex';
                });
            }
        }
    });
</script>
