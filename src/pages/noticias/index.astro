---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts } from '../../utils/posts';

const posts = allPosts.filter(post => post.file.startsWith('noticias/'));
const categoryPosts = posts
    .filter(post => {
        const title = post.title;
        // Ignora a própria página de índice e posts sem título
        return post.url && title && !post.isIndex;
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || '0').getTime();
        const dateB = new Date(b.date || '0').getTime();
        return dateB - dateA;
    });

const categoria = "noticias";
const title = "Notícias";
const description = "Acompanhe as principais notícias do Brasil e do mundo sobre economia, tecnologia, política e mercado, com resumos claros e atualizados diariamente.";
---

<MainLayout seo={{ title, description }} categoria={categoria} showRelacionados={false}>
    <h1 class="page-title" style="margin-bottom: 2rem; color: #2563eb;">{title}</h1>
    
    <section class="category-intro">
        <p>Fique por dentro das <strong>últimas notícias e atualizações</strong> que realmente importam. Aqui no Lucrar Online, acompanhamos os principais acontecimentos do Brasil e do mundo, com foco em economia, tecnologia, política e mercado. Nossa equipe seleciona e resume as informações mais relevantes para que você se mantenha informado sem perder tempo.</p>
    </section>
    
    <div class="posts-grid">
        {categoryPosts.length > 0 ? (
            categoryPosts.map((post, index) => {
                const postTitle = post.title;
                const postDescription = post.description;
                const postImage = post.image || '/images/default-post.webp';
                const postDate = post.date;
                
                return (
                    <PostCard 
                        title={postTitle}
                        description={postDescription}
                        url={post.url}
                        image={postImage}
                        date={postDate}
                        priority={index === 0}
                    />
                );
            })
        ) : (
            <p style="text-align: center; grid-column: 1 / -1; padding: 2rem; color: #666;">
                Ainda não há notícias publicadas. Volte em breve!
            </p>
        )}
    </div>
</MainLayout>
