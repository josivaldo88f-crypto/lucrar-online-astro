---
import MainLayout from '../layouts/MainLayout.astro';
import PostCard from '../components/PostCard.astro';
import { cardImage } from '../utils/image';

const posts = await Astro.glob('./**/*.astro');

const latestPosts = posts
    .filter(post => {
        const title = post.title || post.frontmatter?.title;
        const url = post.url;

        if (!url || !title) return false;

        const isIndexFile = post.file.endsWith('index.astro');

        return !isIndexFile;
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || a.frontmatter?.date || '0').getTime();
        const dateB = new Date(b.date || b.frontmatter?.date || '0').getTime();
        return dateB - dateA;
    })
    .slice(0, 12);

const preloadImage = cardImage(latestPosts[0]?.image || latestPosts[0]?.frontmatter?.image || '/images/default-post.webp');

const title = "Seu Guia para Renda Extra na Internet";
const description = "Conheça aplicativos, sites, jogos e ferramentas para avaliar oportunidades de renda extra na internet, com análises, comparativos e cuidados essenciais.";
const heroSubtitle = "Conheça aplicativos, sites, ferramentas e cuidados para avaliar oportunidades de renda extra na internet";
const categoria = "home";
---

<MainLayout seo={{ title, description }} categoria={categoria} preloadImage={preloadImage}>
    <section class="hero">
        <span class="hero-badge">Guias e análises</span>
        <h1 class="hero-title">Aprenda a Lucrar Online e Criar Renda Extra</h1>
        <p class="hero-subtitle">{heroSubtitle}</p>
        <form class="hero-search" action="/buscar/" method="get" role="search">
            <label class="sr-only" for="hero-search-input">Pesquisar no site</label>
            <input id="hero-search-input" name="q" type="search" placeholder="Ex.: aplicativos que pagam no Pix" required />
            <button type="submit">Buscar</button>
        </form>
        <div class="hero-chips">
            <a class="chip" href="/ganhar-dinheiro/">Ganhar Dinheiro</a>
            <a class="chip" href="/noticias/">Notícias</a>
            <a class="chip" href="/futebol/">Futebol</a>
            <a class="chip" href="/comprar/">Comprar</a>
            <a class="chip" href="/ferramentas/">Ferramentas</a>
        </div>
    </section>

    <section class="section-header" aria-labelledby="ultimas-publicacoes">
        <h2 class="section-title" id="ultimas-publicacoes">Últimas publicações</h2>
        <a class="section-link" href="/post/">Ver todas <span aria-hidden="true">→</span></a>
    </section>

    <section class="posts-grid">
        {latestPosts.map((post, index) => {
            const postTitle = post.title || post.frontmatter?.title;
            const postDescription = post.description || post.frontmatter?.description;
            const postImage = post.image || post.frontmatter?.image || '/images/default-post.webp';
            const postDate = post.date || post.frontmatter?.date;
            
            return (
                <PostCard 
                    title={postTitle}
                    description={postDescription}
                    url={post.url}
                    image={postImage}
                    date={postDate}
                    priority={index === 0}
                />
            );
        })}
    </section>
</MainLayout>
