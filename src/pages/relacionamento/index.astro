---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts } from '../../utils/posts';

const posts = allPosts.filter(post => post.file.startsWith('relacionamento/'));
const categoryPosts = posts
    .filter(post => {
        const title = post.title;
        return post.url && title && post.url !== Astro.url.pathname && post.url !== Astro.url.pathname + '/';
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || '0').getTime();
        const dateB = new Date(b.date || '0').getTime();
        return dateB - dateA;
    });

const categoria = "relacionamento";
const title = "Relacionamento";
const description = "Encontre dicas e aplicativos de relacionamento para conhecer pessoas, melhorar a comunicação e fortalecer seus vínculos afetivos com mais segurança.";
---

<MainLayout seo={{ title, description }} categoria={categoria} showRelacionados={false}>
    <h1 class="page-title" style="margin-bottom: 2rem; color: #2563eb;">{title}</h1>
    
    <section class="category-intro">
        <p>Dicas, aplicativos e guias para <strong>melhorar seus relacionamentos</strong> e encontrar o par ideal. Se você está em busca de um novo amor ou quer fortalecer os laços existentes, nossa seção de relacionamento traz conteúdos selecionados para ajudar você a se conectar com outras pessoas de forma genuína e significativa.</p>
    </section>
    
    <div class="posts-grid">
        {categoryPosts.map((post, index) => {
            const postTitle = post.title;
            const postDescription = post.description;
            const postImage = post.image || '/images/default-post.webp';
            const postDate = post.date;
            
            return (
                <PostCard 
                    title={postTitle}
                    description={postDescription}
                    url={post.url}
                    image={postImage}
                    date={postDate}
                priority={index === 0}
                />
            );
        })}
    </div>
</MainLayout>
