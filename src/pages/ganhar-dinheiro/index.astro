---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts } from '../../utils/posts';

const posts = allPosts;
const categoryPosts = posts
    .filter(post => {
        const title = post.title;
        const postCategoria = post.categoria;
        
        // Deve ter título, URL e a categoria correta
        // E não ser a própria página de índice
        return (
            post.url && 
            title && 
            post.url !== Astro.url.pathname && 
            post.url !== Astro.url.pathname + '/' &&
            postCategoria === "GANHAR DINHEIRO" &&
            post.locale !== 'en'
        );
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || '0').getTime();
        const dateB = new Date(b.date || '0').getTime();
        return dateB - dateA;
    });

const categoria = "GANHAR DINHEIRO";
const title = "Ganhar Dinheiro";
const description = "Guias sobre aplicativos, pesquisas, jogos e plataformas que anunciam recompensas, com regras e cuidados para avaliar cada opção.";
---

<MainLayout seo={{ title, description }} categoria={categoria} showRelacionados={false}>
    <h1 class="page-title" style="margin-bottom: 2rem; color: #2563eb;">{title}</h1>
    
    <section class="category-intro">
        <p>Conheça aplicativos, jogos e sites que anunciam recompensas ou oportunidades de renda extra. Comparamos formas de uso, possíveis resgates e cuidados importantes. Regras e valores podem mudar, por isso confirme as condições diretamente em cada plataforma.</p>
    </section>
    
    <div class="posts-grid">
        {categoryPosts.map((post, index) => {
            const postTitle = post.title;
            const postDescription = post.description;
            const postImage = post.image || '/images/default-post.webp';
            const postDate = post.date;
            
            return (
                <PostCard 
                    title={postTitle}
                    description={postDescription}
                    url={post.url}
                    image={postImage}
                    date={postDate}
                priority={index === 0}
                />
            );
        })}
    </div>
</MainLayout>
