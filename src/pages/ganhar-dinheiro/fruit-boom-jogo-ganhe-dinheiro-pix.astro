<style>
    .post-full {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }

    .post-title {
        color: #333;
        margin-bottom: 15px;
        font-size: 2em;
    }

    .post-meta {
        color: #666;
        font-size: 0.9em;
        margin-bottom: 20px;
    }

    .post-image-container {
        margin: 20px 0;
        text-align: center;
    }

    .featured-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .post-content {
        line-height: 1.8;
        color: #444;
        font-size: 1.05em;
    }

    .post-content h2 {
        color: #222;
        margin-top: 30px;
        margin-bottom: 15px;
        border-bottom: 3px solid #FFD700;
        padding-bottom: 10px;
    }

    .post-content ul {
        margin: 15px 0 15px 30px;
    }

    .post-content li {
        margin: 10px 0;
    }

    .cta-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        border-radius: 8px;
        margin: 30px 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .cta-box h3 {
        margin-top: 0;
        font-size: 1.4em;
    }

    .cta-box h4 {
        color: #FFD700;
        margin-top: 15px;
    }

    .invite-section {
        background: rgba(0,0,0,0.1);
        padding: 15px;
        border-radius: 6px;
        margin: 15px 0;
    }

    .download-section {
        background: rgba(0,0,0,0.1);
        padding: 15px;
        border-radius: 6px;
    }

    .copy-container {
        display: flex;
        gap: 10px;
        margin: 10px 0;
        flex-wrap: wrap;
    }

    .code-input {
        flex: 1;
        min-width: 200px;
        padding: 12px;
        border: none;
        border-radius: 4px;
        font-size: 1.1em;
        font-weight: bold;
        background: white;
        color: #333;
    }

    .copy-btn {
        padding: 12px 20px;
        background: #FFD700;
        color: #333;
        border: none;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.3s;
        white-space: nowrap;
    }

    .copy-btn:hover {
        background: #FFC700;
    }

    .copy-feedback {
        margin: 10px 0 0 0;
        font-weight: bold;
    }

    .download-btn {
        display: inline-block;
        padding: 15px 30px;
        background: #FFD700;
        color: #333;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 1.1em;
        transition: background 0.3s, transform 0.2s;
        border: none;
        cursor: pointer;
        margin: 10px 0;
    }

    .download-btn:hover {
        background: #FFC700;
        transform: translateY(-2px);
    }

    .download-info {
        font-size: 0.9em;
        margin-top: 10px;
        color: #ddd;
    }

    .cta-final {
        text-align: center;
        margin-top: 40px;
    }

    .download-btn-final {
        display: inline-block;
        padding: 18px 40px;
        background: linear-gradient(135deg, #FFD700, #FFC700);
        color: #333;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        font-size: 1.2em;
        transition: transform 0.3s, box-shadow 0.3s;
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
    }

    .download-btn-final:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(255, 215, 0, 0.6);
    }

    @media (max-width: 600px) {
        .post-title {
            font-size: 1.5em;
        }

        .copy-container {
            flex-direction: column;
        }

        .code-input {
            min-width: 100%;
        }

        .cta-box {
            padding: 15px;
        }
    }
</style>

<script is:inline>
    window.copyToClipboard = function() {
        const codeInput = document.getElementById('inviteCode');
        const feedback = document.getElementById('copyFeedback');
        
        // Seleciona o texto
        codeInput.select();
        codeInput.setSelectionRange(0, 99999);
        
        // Copia para clipboard
        navigator.clipboard.writeText(codeInput.value).then(() => {
            feedback.style.display = 'block';
            
            // Esconde a mensagem após 2 segundos
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 2000);
        }).catch(err => {
            alert('Erro ao copiar: ' + err);
        });
    }
</script>