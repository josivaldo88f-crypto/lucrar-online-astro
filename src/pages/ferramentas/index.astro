---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts } from '../../utils/posts';

const posts = allPosts.filter(post => post.file.startsWith('ferramentas/'));
const categoryPosts = posts
    .filter(post => {
        const title = post.title;
        return post.url && title && post.url !== Astro.url.pathname && post.url !== Astro.url.pathname + '/';
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || '0').getTime();
        const dateB = new Date(b.date || '0').getTime();
        return dateB - dateA;
    });

const categoria = "ferramentas";
const title = "Ferramentas";
const description = "Use calculadoras financeiras gratuitas para porcentagem, juros compostos e outros cálculos do dia a dia, com explicações, fórmulas e exemplos práticos.";
---

<MainLayout seo={{ title, description }} categoria={categoria} showRelacionados={false}>
    <h1 class="page-title" style="margin-bottom: 2rem; color: #2563eb;">{title}</h1>
    
    <section class="category-intro">
        <p>Utilidades e <strong>calculadoras online gratuitas</strong> para facilitar seu dia a dia. Resolva cálculos de porcentagem, juros compostos e muito mais com nossas ferramentas práticas e intuitivas. Cada calculadora vem acompanhada de explicações detalhadas e exemplos reais para ajudar você a entender e aplicar os conceitos no seu cotidiano financeiro.</p>
    </section>
    
    <div class="posts-grid">
        {categoryPosts.map((post, index) => {
            const postTitle = post.title;
            const postDescription = post.description;
            const postImage = post.image || '/images/default-post.webp';
            const postDate = post.date;
            
            return (
                <PostCard 
                    title={postTitle}
                    description={postDescription}
                    url={post.url}
                    image={postImage}
                    date={postDate}
                priority={index === 0}
                />
            );
        })}
    </div>
</MainLayout>
