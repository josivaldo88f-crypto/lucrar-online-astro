---
import MainLayout from '../layouts/MainLayout.astro';

export const title = "Apps Removidos";
export const description = "Os apps desta pagina foram removidos por politicas.";
export const categoria = "GANHAR DINHEIRO";
---
<MainLayout title={title} description={description} categoria={categoria} showRelacionados={false}>
    <style>
        .notice-container {
            max-width: 760px;
            margin: 0 auto;
            padding: 3rem 1rem;
        }
        .notice-box {
            background: #fff7ed;
            border: 1px solid #fdba74;
            border-radius: 12px;
            padding: 2rem 1.25rem;
            text-align: center;
        }
        .notice-title {
            margin: 0 0 0.75rem;
            color: #c2410c;
            font-size: 1.8rem;
        }
        .notice-text {
            margin: 0;
            color: #7c2d12;
            font-size: 1rem;
            line-height: 1.7;
        }
        @media (max-width: 480px) {
            .notice-container {
                padding: 2rem 0.75rem;
            }
            .notice-box {
                padding: 1.5rem 1rem;
            }
            .notice-title {
                font-size: 1.5rem;
            }
            .notice-text {
                font-size: 0.9rem;
            }
        }
    </style>

    <div class="notice-container">
        <div class="notice-box">
            <h1 class="notice-title">Apps Removidos</h1>
            <p class="notice-text">
                Os aplicativos desta pagina foram removidos por politicas. No momento, a lista de apps nao esta mais disponivel.
            </p>
        </div>
    </div>
</MainLayout>
