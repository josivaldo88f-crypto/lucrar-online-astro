    <script>
        document.querySelectorAll('.fone-gallery').forEach(gallery => {
            const wrapper = gallery.querySelector('.slider-wrapper');
            const prevBtn = gallery.querySelector('.slider-btn.prev');
            const nextBtn = gallery.querySelector('.slider-btn.next');
            const dots = gallery.querySelectorAll('.dot');
            const total = wrapper.children.length;
            let current = 0;

            function updateSlider() {
                wrapper.style.transform = `translateX(-${current * 100}%)`;
                dots.forEach((dot, i) => {
                    dot.classList.toggle('active', i === current);
                });
                prevBtn.disabled = current === 0;
                nextBtn.disabled = current === total - 1;
            }

            prevBtn.addEventListener('click', () => {
                if (current > 0) { current--; updateSlider(); }
            });

            nextBtn.addEventListener('click', () => {
                if (current < total - 1) { current++; updateSlider(); }
            });

            dots.forEach(dot => {
                dot.addEventListener('click', () => {
                    current = parseInt(dot.dataset.index);
                    updateSlider();
                });
            });

            updateSlider();
        });
    </script>
