---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = await Astro.glob('./*.astro');
const categoryPosts = posts
    .filter(post => {
        const title = post.title || post.frontmatter?.title;
        // Ignora a própria página de índice e posts sem título
        return post.url && title && post.url !== Astro.url.pathname && post.url !== Astro.url.pathname + '/';
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || a.frontmatter?.date || '0').getTime();
        const dateB = new Date(b.date || b.frontmatter?.date || '0').getTime();
        return dateB - dateA;
    });

const categoria = "comprar";
const title = "Comprar";
const description = "As melhores opções de compra, listas de produtos recomendados e guias para ajudar você a escolher o que vale a pena.";
---

<MainLayout title={title} description={description} categoria={categoria} showRelacionados={false}>
    <h1 class="page-title" style="margin-bottom: 2rem; color: #2563eb;">{title}</h1>
    
    <section class="category-intro">
        <p>Bem-vindo à nossa central de <strong>recomendações de compras</strong>! Aqui você encontra as melhores opções de produtos com excelente custo-benefício, selecionados criteriosamente com base nas avaliações dos usuários e preços imperdíveis. De fones de ouvido a eletrônicos, nossos guias ajudam você a escolher o produto ideal sem gastar muito. Todas as listas são atualizadas regularmente para trazer as melhores ofertas do mercado brasileiro.</p>
    </section>
    
    <div class="posts-grid">
        {categoryPosts.length > 0 ? (
            categoryPosts.map(post => {
                const postTitle = post.title || post.frontmatter?.title;
                const postDescription = post.description || post.frontmatter?.description;
                const postImage = post.image || post.frontmatter?.image || '/images/default-post.webp';
                const postDate = post.date || post.frontmatter?.date;
                
                return (
                    <PostCard 
                        title={postTitle}
                        description={postDescription}
                        url={post.url}
                        image={postImage}
                        date={postDate}
                    />
                );
            })
        ) : (
            <p style="text-align: center; grid-column: 1 / -1; padding: 2rem; color: #666;">
                Ainda não há produtos publicados. Volte em breve!
            </p>
        )}
    </div>
</MainLayout>
