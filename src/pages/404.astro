---
import MainLayout from '../layouts/MainLayout.astro';

const title = "Página não encontrada";
const description = "Desculpe, a página que você procura não existe ou foi movida.";
const categoria = "geral";
---

<MainLayout seo={{ title, description, noindex: true }} categoria={categoria}>
    <main style="text-align: center; padding: 4rem 1rem; min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <h1 style="font-size: 5rem; color: #2563eb; margin: 0;">404</h1>
        <h2 style="color: #374151; margin-top: 0.5rem;">Página não encontrada</h2>
        <p style="color: #6b7280; font-size: 1.125rem; max-width: 500px; margin: 1rem auto 2rem;">
            Desculpe, a página que você está procurando não existe, foi movida ou o link está quebrado.
        </p>
        <a href="/" style="display: inline-block; background-color: #2563eb; color: white; padding: 0.75rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background-color 0.2s;">
            Voltar para o início
        </a>
        <p style="color: #9ca3af; font-size: 0.875rem; margin-top: 2rem;">
            Se você acha que isso é um erro, entre em contato conosco.
        </p>
    </main>
</MainLayout>
