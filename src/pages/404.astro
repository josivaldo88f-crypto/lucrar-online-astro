---
import MainLayout from '../layouts/MainLayout.astro';

const title = "Página não encontrada";
const description = "Página não encontrada no Lucrar Online. O endereço pode ter mudado ou o link está quebrado. Volte ao início para continuar navegando pelo site.";
const categoria = "geral";
---

<MainLayout seo={{ title, description, noindex: true }} categoria={categoria}>
    <section class="not-found">
        <p class="not-found-code" aria-hidden="true">404</p>
        <h1 class="not-found-title">Página não encontrada</h1>
        <p class="not-found-text">
            Desculpe, a página que você está procurando não existe, foi movida ou o link está quebrado.
        </p>
        <a href="/" class="action-button">Voltar para o início</a>
        <p class="not-found-hint">
            Se você acha que isso é um erro, entre em contato conosco.
        </p>
    </section>
</MainLayout>
