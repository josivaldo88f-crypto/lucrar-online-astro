---
import MatchArticle from '../../components/MatchArticle.astro';

export const title = 'Chapecoense x Flamengo: Onde Assistir (22/7)';
export const description = 'Confira onde assistir Chapecoense x Flamengo em 22 de julho pelo Brasileirão 2026: horário, Arena Condá, transmissão e contexto.';
export const date = '2026-07-21';
export const image = '/images/brasileirao-onde-assistir.webp';
---
<MatchArticle
    title={title}
    description={description}
    datePublished="2026-07-21"
    matchDate="22 de julho de 2026 (quarta-feira)"
    startDate="2026-07-22T21:30:00-03:00"
    time="21h30"
    round="19ª rodada"
    homeTeam="Chapecoense"
    awayTeam="Flamengo"
    venue="Arena Condá"
    city="Chapecó (SC)"
    broadcast="Globo e Premiere"
    newsTitle="Flamengo volta a campo como vice-líder"
    newsText="O Flamengo é apontado como vice-líder no retorno da Série A e visita a Chapecoense em Chapecó. O duelo está entre os jogos da rodada com transmissão na Globo e no Premiere."
    sourceUrl="https://ge.globo.com/ba/futebol/brasileirao-serie-a/noticia/2026/07/16/brasileirao-2026-veja-onde-assistir-ao-vivo-aos-jogos-da-19a-rodada.ghtml"
    sourceLabel="ge"
/>
