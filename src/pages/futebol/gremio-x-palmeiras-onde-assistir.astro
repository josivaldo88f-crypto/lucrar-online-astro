---
import MainLayout from '../../layouts/MainLayout.astro';

export const title = 'Grêmio x Palmeiras: Onde Assistir, Horário e Escalações (Brasileirão)';
export const description = 'Saiba onde assistir Grêmio x Palmeiras ao vivo domingo (20/9), às 11h, pela 28ª rodada do Brasileirão 2026. Confira transmissão, arbitragem e escalações prováveis.';
export const categoria = 'futebol';
export const date = '2026-09-18';
export const image = '/images/gremio-x-palmeiras-onde-assistir.webp';

const startDate = '2026-09-20T11:00:00-03:00';
const endDate = '2026-09-20T13:00:00-03:00';
const cover720 = image.replace(/\.webp$/, '-720.webp');

const faq = [
    {
        question: 'Onde assistir Grêmio x Palmeiras ao vivo?',
        answer: 'A partida terá transmissão ao vivo e exclusiva em todo o Brasil pelo Premiere no sistema pay-per-view e via streaming pelo Globoplay (para assinantes do pacote com Premiere). O ge.globo cobre a partida lance a lance em tempo real com vídeos dos principais lances.',
    },
    {
        question: 'Por que o jogo Grêmio x Palmeiras não vai passar na Globo nem no SporTV?',
        answer: 'O confronto acontece às 11h de domingo, faixa matinal que pertence com exclusividade ao canal Premiere no modelo pay-per-view. A TV Globo reserva sua grade dominical da manhã para programas de variedades e telejornais locais, mantendo o futebol ao vivo na TV aberta apenas às 16h. O SporTV também não exibe jogos nessa janela devido à distribuição dos direitos dentro do Grupo Globo.',
    },
    {
        question: 'Que horas começa Grêmio x Palmeiras neste domingo?',
        answer: 'A bola rola às 11h00 (horário de Brasília) deste domingo, 20 de setembro de 2026, na Arena do Grêmio, em Porto Alegre.',
    },
    {
        question: 'Qual é o impacto do feriado de 20 de Setembro na partida?',
        answer: 'O dia 20 de setembro celebra o Dia do Gaúcho e a Revolução Farroupilha, a data cívica de maior mobilização no Rio Grande do Sul. O clima patriótico e tradicionalista da capital gaúcha impulsiona a torcida tricolor, que promete lotar a Arena do Grêmio em festa com trajes típicos e cantos tradicionalistas.',
    },
    {
        question: 'Por que Abel Ferreira não estará à beira do gramado pelo Palmeiras?',
        answer: 'O técnico Abel Ferreira cumpre suspensão disciplinar imposta pelo Superior Tribunal de Justiça Desportiva (STJD). O Verdão será comandado no banco de reservas pelo seu primeiro auxiliar técnico, o português João Martins.',
    },
    {
        question: 'Como chegam Grêmio e Palmeiras na tabela do Brasileirão?',
        answer: 'O Grêmio ocupa a 16ª colocação com 28 pontos e luta para se afastar da zona de rebaixamento após a demissão de Luís Castro e a contratação de Renato Gaúcho. Já o Palmeiras é o vice-líder isolado com 56 pontos, a apenas um ponto do líder Flamengo, e disputa ponto a ponto o título nacional.',
    },
    {
        question: 'Quem apita a partida entre Grêmio e Palmeiras?',
        answer: 'O árbitro principal escalado pela CBF é Paulo Cesar Zanovelli da Silva (FIFA/MG), com auxílio de Paulo Renato Moreira da Silva Coelho (RJ) na operação do árbitro de vídeo (VAR).',
    },
    {
        question: 'Qual a expectativa de público na Arena do Grêmio?',
        answer: 'Motivada pelo feriado farroupilha e a reestreia de Renato Gaúcho, a torcida esgotou setores como a Arquibancada Norte e Cadeiras Gramado. A administração do estádio estima público superior a 42 mil pessoas no Humaitá.',
    },
];

const eventJson = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: 'Grêmio x Palmeiras pelo Brasileirão 2026',
    description,
    startDate,
    endDate,
    sport: 'Futebol',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [new URL(image, Astro.site ?? 'https://www.lucrar.link/').href],
    location: {
        '@type': 'Place',
        name: 'Arena do Grêmio',
        address: {
            '@type': 'PostalAddress',
            streetAddress: 'Av. Padre Leopoldo Brentano, 110 - Bairro Humaitá',
            addressLocality: 'Porto Alegre',
            addressRegion: 'RS',
            postalCode: '90250-590',
            addressCountry: 'BR',
        },
    },
    competitor: [
        {
            '@type': 'SportsTeam',
            name: 'Grêmio',
            logo: new URL('/images/escudo-gremio.webp', Astro.site ?? 'https://www.lucrar.link/').href,
        },
        {
            '@type': 'SportsTeam',
            name: 'Palmeiras',
            logo: new URL('/images/escudo-palmeiras.webp', Astro.site ?? 'https://www.lucrar.link/').href,
        },
    ],
    homeTeam: {
        '@type': 'SportsTeam',
        name: 'Grêmio',
        logo: new URL('/images/escudo-gremio.webp', Astro.site ?? 'https://www.lucrar.link/').href,
    },
    awayTeam: {
        '@type': 'SportsTeam',
        name: 'Palmeiras',
        logo: new URL('/images/escudo-palmeiras.webp', Astro.site ?? 'https://www.lucrar.link/').href,
    },
    organizer: {
        '@type': 'Organization',
        name: 'Confederação Brasileira de Futebol',
        url: 'https://www.cbf.com.br/',
    },
});
---

<MainLayout
    seo={{ title, description, image, datePublished: date, dateModified: date, faq }}
    categoria={categoria}
    preloadImage={image}
    preloadImageSrcset={`${cover720} 720w, ${image} 1200w`}
    preloadImageSizes="(max-width: 900px) 92vw, 900px"
>
    <script slot="head" type="application/ld+json" set:html={eventJson}></script>

    <article class="match-article">
        <header class="match-hero">
            <p class="match-kicker">Brasileirão 2026 · 28ª rodada · Arena do Grêmio</p>
            <h1>{title}</h1>
            <p class="match-updated">Por Redação de Esportes · Atualizado em <time datetime={date}>18 de setembro de 2026</time></p>
        </header>

        <img
            class="match-cover"
            src={image}
            srcset={`${cover720} 720w, ${image} 1200w`}
            sizes="(max-width: 900px) 92vw, 900px"
            alt="Grêmio x Palmeiras na Arena do Grêmio pela 28ª rodada do Brasileirão 2026"
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />

        <p class="match-lead">
            Em clima de celebração cívica e urgência máxima dentro das quatro linhas, Grêmio e Palmeiras medem forças neste domingo (20/9), às 11h00 (horário de Brasília), na Arena do Grêmio, pela 28ª rodada do Campeonato Brasileiro 2026. A partida coincide com o feriado de 20 de Setembro — o Dia do Gaúcho, data magna da Revolução Farroupilha —, transformando o Bairro Humaitá em um formigueiro tricolor. O duelo marca a reestreia de Renato Gaúcho Portaluppi, que assume o comando gremista pela 5ª vez na carreira para salvar o clube da zona da degola (16º colocado, com 28 pontos). Do outro lado, o Palmeiras de João Martins (substituindo o suspenso Abel Ferreira) soma 56 pontos e segue na perseguição incansável à liderança do campeonato, embalado pela heroica classificação nos pênaltis contra a LDU na altitude de Quito.
        </p>

        <section class="match-summary" aria-labelledby="ficha-do-jogo">
            <h2 id="ficha-do-jogo">Ficha do jogo</h2>
            <dl class="match-details">
                <div><dt>Data</dt><dd>Domingo, 20 de setembro de 2026</dd></div>
                <div><dt>Horário</dt><dd>11h00 (horário de Brasília)</dd></div>
                <div><dt>Estádio</dt><dd>Arena do Grêmio</dd></div>
                <div><dt>Local</dt><dd>Porto Alegre (RS)</dd></div>
                <div><dt>Transmissão</dt><dd>Premiere e Globoplay</dd></div>
                <div><dt>Tempo Real</dt><dd>ge.globo</dd></div>
                <div><dt>Árbitro</dt><dd>Paulo Cesar Zanovelli da Silva (FIFA/MG)</dd></div>
                <div><dt>VAR</dt><dd>Paulo Renato Moreira da Silva Coelho (RJ)</dd></div>
            </dl>
        </section>

        <section class="match-content">
            <h2>Onde assistir Grêmio x Palmeiras ao vivo na TV e online</h2>
            <p>
                O confronto matinal deste domingo terá cobertura exclusiva para os assinantes de canais por assinatura e plataformas de streaming do Grupo Globo:
            </p>
            <ul>
                <li>
                    <strong>Premiere:</strong> transmite o jogo ao vivo para todo o território nacional pelo sistema pay-per-view nas principais operadoras de TV paga (Claro TV, Sky, Vivo Play, Oi TV), com narração ao vivo direto da cabine da Arena do Grêmio, pré-jogo completo e reportagens de campo.
                </li>
                <li>
                    <strong>Globoplay:</strong> disponibiliza o sinal ao vivo do Premiere em alta definição através do aplicativo para smartphones, tablets, Smart TVs e navegadores (exclusivo para assinantes do pacote Globoplay + Premiere).
                </li>
                <li>
                    <strong>ge.globo:</strong> acompanha minuto a minuto em tempo real com vídeos instantâneos dos gols, defesas capitais, análise de lances polêmicos e comentários da equipe de arbitragem.
                </li>
            </ul>

            <h2>Por que o jogo não terá transmissão na Globo aberta e nem no SporTV?</h2>
            <p>
                A ausência de Grêmio x Palmeiras nas telas da TV aberta e do SporTV atende a um formato comercial consolidado na televisão brasileira. Historicamente, a faixa das 11h de domingo é reservada pela CBF e pelas emissoras como vitrine exclusiva do <strong>Premiere</strong> no modelo pay-per-view, funcionando como o principal chamariz de venda para o pacote de assinaturas dominicais.
            </p>
            <p>
                Na TV aberta, a TV Globo dedica as manhãs de domingo a sua tradicional grade de entretenimento, jornalismo rural e edições regionais do Globo Esporte / Esporte Espetacular, concentrando a sua cota de transmissões de futebol ao vivo no horário nobre das 16h. É justamente às 16h que a emissora exibe para todo o país o clássico entre <a href="/futebol/corinthians-x-fluminense-onde-assistir/">Corinthians e Fluminense</a> na Neo Química Arena. Já no SporTV, a janela matinal de domingo é reservada à cobertura poliesportiva e debates pré-jogo, sem concorrência direta com a venda do pay-per-view.
            </p>

            <h2>Dia do Gaúcho e o quinto capítulo da era Renato Portaluppi</h2>
            <p>
                Raramente um jogo de Brasileirão carrega tanta carga simbólica em Porto Alegre. A data de <strong>20 de Setembro</strong> representa o ápice cívico do Rio Grande do Sul, comemorando o início da Revolução Farroupilha. Desde as primeiras horas da manhã, o Bairro Humaitá recebe carreatas, piquetes tradicionalistas com chimarrão e churrasco, além de milhares de gremistas vestindo faixas e lenços farroupilhas ao redor do estádio.
            </p>
            <p>
                Essa atmosfera ganha combustão pura com o retorno de <strong>Renato Gaúcho Portaluppi</strong>. Demitido após uma sequência de cinco partidas sem vitórias e um ambiente desgastado no vestiário, o português Luís Castro deixou o Tricolor à beira do precipício: na 16ª posição com 28 pontos, empatado com o primeiro clube dentro do Z-4. Sem tempo para experiências táticas complexas, a diretoria recorreu ao seu maior ídolo para uma quinta passagem salvadora.
            </p>
            <p>
                Renato desembarcou em Porto Alegre exigindo compromisso irrestrito e resgatando a famosa "cartilha da intensidade tricolor". Conhecido pela capacidade de destravar o aspecto anímico de atletas em baixa, o treinador trabalhou o posicionamento defensivo durante os treinos fechados no CT Luiz Carvalho, buscando estancar os erros individuais na zaga e conferir liberdade de criação aos homens de frente.
            </p>

            <h2>Palmeiras em modo caça à liderança após epopeia em Quito</h2>
            <p>
                Se o Grêmio luta para não afundar, o Palmeiras desembarca no Sul com a mira travada na ponta da tabela. Com 56 pontos, o time paulista é o vice-líder e persegue o Flamengo (líder com 57 pontos), que entra em campo somente no início da noite contra o <a href="/futebol/flamengo-x-bragantino-onde-assistir/">Red Bull Bragantino</a> no Maracanã. Um triunfo em Porto Alegre coloca o Verdão provisoriamente no topo e transfere uma pressão descomunal aos cariocas.
            </p>
            <p>
                O Alviverde, no entanto, precisará superar a fadiga acumulada de uma verdadeira guerra no meio de semana. Na altitude de mais de 2.800 metros de Quito, o Palmeiras suportou 120 minutos de sufoco físico diante da LDU e arrancou a classificação às semifinais da Libertadores na disputa de pênaltis. O grande herói da noite equatoriana foi o goleiro <strong>Carlos Miguel</strong>, que defendeu duas cobranças e se consagrou definitivamente debaixo das traves alviverdes, consolidando status de titular incontestável.
            </p>
            <p>
                No banco de reservas, a novidade é a presença do auxiliar técnico <strong>João Martins</strong>. O titular Abel Ferreira foi suspenso por duas partidas pelo Superior Tribunal de Justiça Desportiva (STJD) em razão de reclamações contundentes à arbitragem. Sob a batuta de Martins — que possui aproveitamento invejável quando comanda o time à beira do campo —, o Palmeiras promete uma postura madura e pragmática para suportar o abafa tricolor.
            </p>

            <h2>Duelo tático setor por setor: onde o jogo será decidido</h2>
            <p>
                O embate entre a reestruturação gremista e a máquina competitiva palmeirense reserva duelos individuais fascinantes em cada palmo do gramado da Arena:
            </p>
            <ul>
                <li>
                    <strong>O motor da volância: Mathias Villasanti x Marlon Freitas e Andreas Pereira:</strong> O paraguaio Villasanti é a alma da contenção gremista. Sua missão será impedir que Marlon Freitas distribua o jogo com passes longos e, sobretudo, travar a liberdade do criativo Andreas Pereira, cujas assistências e finalizações de média distância desmontam sistemas defensivos compactados.
                </li>
                <li>
                    <strong>A referência física x O paredão zagueiro: Carlos Vinícius x Gómez e Barboza:</strong> O centroavante gremista Carlos Vinícius terá pela frente a dupla de zaga mais sólida do campeonato. O embate com o capitão Gustavo Gómez e o canhoto Alexander Barboza promete disputas corpo a corpo ferozes nas bolas aéreas e jogadas de pivô na entrada da área.
                </li>
                <li>
                    <strong>Acelerando nas pontas: Pavón e Amuzu x Giay e Piquerez:</strong> Renato Gaúcho aposta nos corredores laterais. Cristian Pavón pela direita e o belga Francis Amuzu pela esquerda têm como trunfo o drible agudo e a velocidade pura. Eles tentarão explorar os espaços deixados pelas descidas do argentino Agustín Giay e do uruguaio Joaquín Piquerez, dois laterais modernos que combinam imposição física e chegada ofensiva constante.
                </li>
                <li>
                    <strong>O veneno da frente palmeirense: Vitor Roque e Jhon Arias:</strong> O prodígio Vitor Roque é uma ameaça permanente pelas movimentações fulminantes em facão e o faro de gol cirúrgico. Ao lado de Jhon Arias, cuja capacidade de drible curto e tomada de decisão rápida sobrecarrega as coberturas, o ataque palmeirense exigirá concentração total da zaga gaúcha durante os 90 minutos.
                </li>
            </ul>

            <h2>Ingressos esgotados e expectativa de 42 mil torcedores</h2>
            <p>
                A união entre o feriado de 20 de Setembro e a volta de Renato Portaluppi causou uma verdadeira corrida às bilheterias digitais do Grêmio. Em menos de 48 horas de abertura de vendas, os setores de <strong>Arquibancada Norte</strong> (espaço da tradicional Geral do Grêmio) e <strong>Cadeiras Gramado Leste e Sul</strong> tiveram sua lotação máxima comercializada.
            </p>
            <p>
                Com ingressos promocionais para dependentes e check-ins em massa do quadro social tricolor, a administração da Arena e a Brigada Militar projetam a presença de aproximadamente <strong>42 mil a 45 mil torcedores</strong>. O clube preparou um mosaico comemorativo alusivo ao Dia do Gaúcho para a entrada das equipes no gramado.
            </p>

            <h2>Retrospecto histórico de Grêmio x Palmeiras</h2>
            <p>
                Grêmio e Palmeiras protagonizam uma das rivalidades interestaduais mais pesadas do futebol sul-americano, repleta de confrontos históricos em decisões de Copa do Brasil (finais de 1996 e 2020) e fases agudas da Copa Libertadores (como o épico 5 a 0 em 1995 e a classificação tricolor no Pacaembu em 2019).
            </p>
            <p>
                No retrospecto geral por competições oficiais da CBF, o equilíbrio é marcante em mais de 100 partidas disputadas. Atuando em seus domínios em Porto Alegre (seja no antigo Estádio Olímpico Monumental ou na moderna Arena), o Grêmio mantém vantagem histórica em vitórias. No entanto, o Palmeiras de Abel Ferreira venceu dois dos últimos quatro confrontos realizados em solo gaúcho, o que atesta a exigência máxima que Renato Gaúcho terá pela frente neste domingo.
            </p>

            <h2>Desfalques e prováveis escalações</h2>
            <div class="lineups">
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-gremio.webp" alt="Escudo do Grêmio" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Grêmio</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Agustín Marchesín; João Pedro, Rodrigo Ely, Wagner Leonardo (ou Walter Kannemann) e Reinaldo; Dodi, Mathias Villasanti e Miguel Monsalve (ou Franco Cristaldo); Cristian Pavón, Francis Amuzu e Carlos Vinícius.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> O volante Pepê segue em recuperação de entorse no tornozelo direito. O zagueiro Pedro Geromel realiza cronograma de controle de carga muscular no departamento médico.
                    </p>
                    <p>
                        <strong>Pendurados:</strong> Reinaldo, Villasanti e Pavón somam dois cartões amarelos e estão sob advertência.
                    </p>
                    <p><strong>Técnico:</strong> Renato Gaúcho Portaluppi.</p>
                </div>
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-palmeiras.webp" alt="Escudo do Palmeiras" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Palmeiras</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Carlos Miguel; Agustín Giay, Gustavo Gómez, Alexander Barboza e Joaquín Piquerez; Marlon Freitas, Richard Ríos (ou Aníbal Moreno) e Andreas Pereira; Jhon Arias, Facundo Torres (ou Maurício) e Vitor Roque.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> O técnico Abel Ferreira cumpre suspensão disciplinar imposta pelo STJD. O atacante Paulinho e o ponta Ramón Sosa seguem em tratamento fisioterápico de lesões musculares.
                    </p>
                    <p>
                        <strong>Herói recente:</strong> O goleiro Carlos Miguel chega em alta máxima após garantir a classificação palmeirense na altitude com duas defesas de pênalti.
                    </p>
                    <p><strong>Técnico interino:</strong> João Martins (auxiliar técnico).</p>
                </div>
            </div>

            <h2>Equipe de arbitragem escalada pela CBF</h2>
            <p>
                A Confederação Brasileira de Futebol designou árbitros experientes do quadro nacional e internacional para administrar o tenso confronto em Porto Alegre:
            </p>
            <ul>
                <li><strong>Árbitro principal:</strong> Paulo Cesar Zanovelli da Silva (FIFA/MG)</li>
                <li><strong>Assistente 1:</strong> Bruno Boschilia (FIFA/PR)</li>
                <li><strong>Assistente 2:</strong> Celso Luiz da Silva (MG)</li>
                <li><strong>Quarto árbitro:</strong> Jefferson Ferreira de Moraes (GO)</li>
                <li><strong>Árbitro de vídeo (VAR):</strong> Paulo Renato Moreira da Silva Coelho (RJ)</li>
                <li><strong>Assistente de VAR (AVAR):</strong> Diogo Carvalho Silva (RJ)</li>
                <li><strong>Observador de VAR:</strong> Nilson de Souza Monção (CBF)</li>
            </ul>
        </section>

        <section class="match-faq" aria-labelledby="perguntas-frequentes">
            <h2 id="perguntas-frequentes">Perguntas frequentes sobre Grêmio x Palmeiras</h2>
            {faq.map((item) => (
                <div class="faq-item">
                    <h3>{item.question}</h3>
                    <p>{item.answer}</p>
                </div>
            ))}
        </section>

        <footer class="match-footer">
            <p>
                Fontes oficiais e cobertura: <a href="https://ge.globo.com/rs/futebol/times/gremio/" target="_blank" rel="noopener noreferrer">ge Grêmio</a>, <a href="https://ge.globo.com/futebol/times/palmeiras/" target="_blank" rel="noopener noreferrer">ge Palmeiras</a> e <a href="https://www.cbf.com.br/" target="_blank" rel="noopener noreferrer">Confederação Brasileira de Futebol (CBF)</a>.
            </p>
            <p>Este pré-jogo informativo é atualizado constantemente com as notícias de vestiário até a confirmação das súmulas oficiais uma hora antes do pontapé inicial.</p>
            <a href="/futebol/corinthians-x-fluminense-onde-assistir/">Confira também: Corinthians x Fluminense ao vivo na TV Globo e Premiere</a>
            <a href="/futebol/flamengo-x-bragantino-onde-assistir/">Veja também: Flamengo x Bragantino no Maracanã pela 28ª rodada</a>
            <a href="/futebol/">← Ver todos os jogos e coberturas de futebol</a>
        </footer>
    </article>
</MainLayout>

<style>
    .match-article { max-width: 900px; margin: 0 auto; }
    .match-hero { margin-bottom: 1.5rem; }
    .match-kicker { margin: 0 0 0.5rem; color: #2563eb; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .match-hero h1 { margin: 0 0 0.6rem; color: #111827; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; }
    .match-updated { margin: 0; color: #6b7280; font-size: 0.9rem; }
    .match-cover { display: block; width: 100%; height: auto; margin-bottom: 1.5rem; border-radius: 12px; }
    .match-lead { margin: 0 0 1.5rem; color: #374151; font-size: 1.15rem; line-height: 1.75; }
    .match-summary { margin: 1.5rem 0 2rem; padding: 1.5rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; }
    .match-summary h2 { margin-top: 0; color: #1f2937; }
    .match-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
    .match-details div { padding: 0.9rem; background: #fff; border-radius: 8px; }
    .match-details dt { color: #6b7280; font-size: 0.85rem; font-weight: 700; }
    .match-details dd { margin: 0.3rem 0 0; color: #111827; font-weight: 600; }
    .match-content { color: #374151; font-size: 1.05rem; line-height: 1.8; }
    .match-content h2 { margin: 2.25rem 0 0.75rem; color: #1f2937; font-size: 1.5rem; }
    .match-content h3 { margin: 1.5rem 0 0.5rem; color: #1f2937; font-size: 1.25rem; }
    .match-content p { margin: 0 0 1rem; }
    .match-content ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
