---
import MainLayout from '../../layouts/MainLayout.astro';

export const title = 'Flamengo x Bragantino: Onde Assistir, Horário e Escalações (Brasileirão)';
export const description = 'Saiba onde assistir Flamengo x Red Bull Bragantino ao vivo neste domingo (20/9), às 18h30, no Maracanã, pela 28ª rodada do Brasileirão 2026. Transmissão, desfalques e escalações.';
export const categoria = 'futebol';
export const date = '2026-09-15';
export const image = '/images/flamengo-x-bragantino-onde-assistir.webp';

const startDate = '2026-09-20T18:30:00-03:00';
const endDate = '2026-09-20T20:30:00-03:00';
const cover720 = image.replace(/\.webp$/, '-720.webp');

const faq = [
    {
        question: 'Onde assistir Flamengo x Red Bull Bragantino ao vivo?',
        answer: 'A partida terá transmissão ao vivo e exclusiva pelo canal Premiere no pay-per-view para todo o Brasil e pelo streaming Globoplay (para assinantes do combo Globoplay + Premiere). O portal ge.globo faz o acompanhamento minuto a minuto em tempo real com vídeos dos principais lances.',
    },
    {
        question: 'Por que o jogo Flamengo x Bragantino não vai passar na Globo aberta?',
        answer: 'A TV Globo exibe tradicionalmente partidas de futebol aos domingos às 16h na TV aberta. Como o confronto do Maracanã foi agendado pela CBF para as 18h30, os direitos de exibição ao vivo pertencem exclusivamente ao Premiere no modelo pay-per-view.',
    },
    {
        question: 'Que horas começa o jogo entre Flamengo e Bragantino?',
        answer: 'A bola rola às 18h30 (horário de Brasília) deste domingo, 20 de setembro de 2026, no Estádio do Maracanã, no Rio de Janeiro.',
    },
    {
        question: 'Onde será a partida entre Flamengo e Red Bull Bragantino?',
        answer: 'O confronto é válido pela 28ª rodada do Campeonato Brasileiro 2026 e será disputado no Estádio Jornalista Mário Filho, o Maracanã, no Rio de Janeiro (RJ).',
    },
    {
        question: 'Quais são os principais desfalques das duas equipes?',
        answer: 'No Flamengo, o lateral Alex Sandro (lesão na panturrilha) e o volante Evertton Araújo (coxa) seguem no departamento médico, além do monitoramento do desgaste físico pós-Libertadores. No Bragantino, o zagueiro Eduardo Santos e o volante Matheus Fernandes são baixas confirmadas por lesão.',
    },
    {
        question: 'Quem comanda a arbitragem de Flamengo x Red Bull Bragantino?',
        answer: 'O árbitro principal escalado pela CBF é Rodrigo José Pereira de Lima (PE), auxiliado por assistentes do quadro nacional. No comando da cabine do VAR, o responsável pelas análises de vídeo é Marco Aurélio Augusto Fazekas Ferreira (MG).',
    },
];

const eventJson = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: 'Flamengo x Red Bull Bragantino pelo Brasileirão 2026',
    description,
    startDate,
    endDate,
    sport: 'Futebol',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [new URL(image, Astro.site ?? 'https://www.lucrar.link/').href],
    location: {
        '@type': 'Place',
        name: 'Estádio Jornalista Mário Filho (Maracanã)',
        address: {
            '@type': 'PostalAddress',
            addressLocality: 'Rio de Janeiro',
            addressRegion: 'RJ',
            addressCountry: 'BR',
        },
    },
    competitor: [
        { '@type': 'SportsTeam', name: 'Flamengo' },
        { '@type': 'SportsTeam', name: 'Red Bull Bragantino' },
    ],
    homeTeam: {
        '@type': 'SportsTeam',
        name: 'Flamengo',
    },
    awayTeam: {
        '@type': 'SportsTeam',
        name: 'Red Bull Bragantino',
    },
    organizer: {
        '@type': 'Organization',
        name: 'Confederação Brasileira de Futebol',
        url: 'https://www.cbf.com.br/',
    },
});
---

<MainLayout
    seo={{ title, description, image, datePublished: date, dateModified: date, faq }}
    categoria={categoria}
    preloadImage={image}
    preloadImageSrcset={`${cover720} 720w, ${image} 1200w`}
    preloadImageSizes="(max-width: 900px) 92vw, 900px"
>
    <script slot="head" type="application/ld+json" set:html={eventJson}></script>

    <article class="match-article">
        <header class="match-hero">
            <p class="match-kicker">Brasileirão 2026 · 28ª rodada · Maracanã</p>
            <h1>{title}</h1>
            <p class="match-updated">Por Redação · Publicado em <time datetime={date}>15 de setembro de 2026</time></p>
        </header>

        <img
            class="match-cover"
            src={image}
            srcset={`${cover720} 720w, ${image} 1200w`}
            sizes="(max-width: 900px) 92vw, 900px"
            alt="Flamengo x Red Bull Bragantino no Maracanã pela 28ª rodada do Brasileirão 2026"
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />

        <p class="match-lead">
            Flamengo e Red Bull Bragantino medem forças neste domingo (20), às 18h30 (horário de Brasília), no Maracanã, em confronto válido pela 28ª rodada do Campeonato Brasileiro 2026. Em meio à corrida eletrizante pela liderança da Série A com o Palmeiras e com a maratona decisiva da Copa Libertadores no retrovisor, o Rubro-Negro recebe um dos seus adversários mais indigestos dos últimos anos. O duelo terá transmissão ao vivo e exclusiva do Premiere e do Globoplay para todo o país.
        </p>

        <section class="match-summary" aria-labelledby="ficha-do-jogo">
            <h2 id="ficha-do-jogo">Ficha do jogo</h2>
            <dl class="match-details">
                <div><dt>Data</dt><dd>Domingo, 20 de setembro de 2026</dd></div>
                <div><dt>Horário</dt><dd>18h30 (horário de Brasília)</dd></div>
                <div><dt>Estádio</dt><dd>Maracanã</dd></div>
                <div><dt>Local</dt><dd>Rio de Janeiro (RJ)</dd></div>
                <div><dt>Transmissão</dt><dd>Premiere e Globoplay</dd></div>
                <div><dt>Tempo Real</dt><dd>ge.globo</dd></div>
                <div><dt>Árbitro</dt><dd>Rodrigo José Pereira de Lima (PE)</dd></div>
                <div><dt>VAR</dt><dd>Marco Aurélio Augusto Fazekas Ferreira (MG)</dd></div>
            </dl>
        </section>

        <section class="match-content">
            <h2>Onde assistir Flamengo x Red Bull Bragantino ao vivo</h2>
            <p>
                Diferente do clássico diante do Corinthians na rodada anterior, o torcedor que deseja acompanhar a partida deste domingo precisará recorrer às plataformas de pay-per-view e streaming fechado:
            </p>
            <ul>
                <li>
                    <strong>Premiere (TV por assinatura e Premiere Play):</strong> exibe a partida com exclusividade em sinal fechado e pay-per-view para todo o Brasil. O canal está disponível nas grades de operadoras como Claro TV+, Sky, Vivo Play e Oi TV, além do acesso móvel no aplicativo Premiere.
                </li>
                <li>
                    <strong>Globoplay (com pacote Premiere):</strong> os assinantes que possuem o combo Globoplay + Premiere têm acesso direto à transmissão digital em alta definição para assistir via Smart TVs, computadores, smartphones e tablets.
                </li>
                <li>
                    <strong>Por que não passa na TV Globo aberta?</strong> A Rede Globo reserva a grade aberta de domingo exclusivamente para os confrontos marcados para as 16h. Com a marcação do duelo no Maracanã para as 18h30, o Grupo Globo mantém exclusividade integral no canal Premiere.
                </li>
                <li>
                    <strong>ge.globo:</strong> acompanha cada detalhe minuto a minuto em tempo real, com vídeos imediatos das principais jogadas, cartões e gols, além das estatísticas de mapa de calor, posse de bola e análise de arbitragem.
                </li>
            </ul>

            <h2>A briga pelo título palmo a palmo e a ressaca da Libertadores</h2>
            <p>
                O Campeonato Brasileiro entra em seu último terço com margem de erro nula na disputa pela taça. O Flamengo iniciou a reta decisiva travando uma batalha ponto a ponto com o Palmeiras na ponta da tabela. Com as duas potências revezando-se na primeira colocação a cada fim de semana, qualquer tropeço em casa representa um golpe severo nas pretensões do título nacional.
            </p>
            <p>
                O maior obstáculo da equipe carioca, contudo, é o calendário impiedoso. Com o duelo decisivo das quartas de final da Libertadores contra o <a href="/futebol/flamengo-x-independiente-del-valle-onde-assistir/">Independiente del Valle</a> na quinta-feira (17), o elenco rubro-negro encara um intervalo menor que 72 horas até o apito inicial no Brasileirão. O técnico Filipe Luís e sua comissão técnica têm o desafio diário de dosar a minutagem dos titulares, controlando o desgaste muscular sem abrir mão da intensidade na pressão e da velocidade de circulação.
            </p>

            <h2>A pedra no sapato: o indigesto histórico contra o Massa Bruta desde 2020</h2>
            <p>
                Se a tabela e o desgaste físico exigem concentração máxima, o adversário impõe respeito redobrado pelo retrospecto recente. Desde a ascensão do projeto Red Bull Bragantino em 2020, o time de Bragança Paulista tornou-se uma das pedras mais incômodas no sapato rubro-negro.
            </p>
            <p>
                Em 11 confrontos pela Série A nessa nova era corporativa do Massa Bruta, o equilíbrio chama a atenção: são três vitórias do Flamengo, quatro empates e quatro vitórias do Bragantino. Longe de se acovardar no Maracanã, a equipe paulista historicamente morde a saída de bola rubro-negra com marcação alta, transições verticais fulminantes e vigor físico típico do DNA da franquia. Para o Mengão, derrubar o Massa Bruta em casa é vencer também uma barreira psicológica no campeonato.
            </p>

            <h2>A "Lei do Ex" de Léo Ortiz e a chave tática nas entrelinhas</h2>
            <p>
                O confronto carrega um forte componente emocional para o miolo de zaga rubro-negro. O zagueiro <strong>Léo Ortiz</strong>, contratado após uma das novelas de mercado mais longas dos últimos anos, reencontra o clube onde foi capitão, esteio defensivo e referência técnica por cinco temporadas.
            </p>
            <p>
                Livre da suspensão automática cumprida no clássico diante do <a href="/futebol/flamengo-x-corinthians-onde-assistir/">Corinthians</a>, Ortiz retorna 100% descansado para assumir o papel de regente da primeira fase de construção. Sua capacidade de quebrar linhas com passes verticais e lançamentos milimétricos será a arma número um para furar a marcação pressão paulista. Na bola aérea ofensiva, sua presença na grande área adversária acende o alerta máximo da inexorável "lei do ex".
            </p>
            <p>
                No tabuleiro tático, a chave da vitória está na faixa entre a volância do Bragantino e sua linha de zaga. Como o time de Fernando Seabra atua com bloco médio-alto e perseguição intensa no pós-perda, abre-se uma cratera nas entrelinhas. É aí que <strong>Giorgian de Arrascaeta</strong> se agiganta. Se o camisa 14 uruguaio receber desmarcado às costas de Jadsom e Eric Ramires virando a frente para o gol, achará os facões em velocidade dos pontas ou deixará Pedro em condições límpidas de arremate.
            </p>

            <h2>Ameaças do Bragantino: as subidas de Juninho Capixaba e o faro de gol de Eduardo Sasha</h2>
            <p>
                Do lado do Massa Bruta, o técnico Fernando Seabra aposta em duas válvulas principais para ferir a retaguarda mandante:
            </p>
            <ul>
                <li>
                    <strong>Juninho Capixaba pela ala esquerda:</strong> O lateral dita o ritmo pelo corredor canhoto. Além de apoiar a linha de fundo com passadas largas e cruzar na medida, capricha nas diagonais por dentro para armar o jogo e assume a responsabilidade máxima nas faltas e escanteios com trajetórias muito venenosas.
                </li>
                <li>
                    <strong>Eduardo Sasha na referência ofensiva:</strong> Veterano com rodagem e leitura refinada de jogo, Sasha é o atacante que não dá sossego aos zagueiros. Ele baixa para tabelar, arrasta a marcação abrindo corredores para os meias e pontas e tem presença de área cirúrgica para finalizar de primeira.
                </li>
            </ul>

            <h2>Desfalques, pendurados e prováveis escalações</h2>
            <div class="lineups">
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-flamengo.webp" alt="Escudo do Flamengo" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Flamengo</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Rossi; Varela (ou Wesley), Léo Ortiz, Léo Pereira e Ayrton Lucas; Erick Pulgar, De la Cruz (ou Carlos Alcaraz) e Arrascaeta; Gerson, Bruno Henrique (ou Everton Cebolinha / Plata) e Pedro.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> O lateral-esquerdo Alex Sandro trata lesão muscular na panturrilha direita e o volante Evertton Araújo segue entregue à fisioterapia para recuperação de problema na coxa. A comissão técnica também reavalia o desgaste de quem atuou os 90 minutos na Libertadores.
                    </p>
                    <p>
                        <strong>Pendurados:</strong> Erick Pulgar, Ayrton Lucas e Gerson seguem na berlinda com dois cartões amarelos acumulados.
                    </p>
                    <p><strong>Técnico:</strong> Filipe Luís.</p>
                </div>
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-bragantino.webp" alt="Escudo do Red Bull Bragantino" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Red Bull Bragantino</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Cleiton; Nathan Mendes, Pedro Henrique, Lucas Cunha e Juninho Capixaba; Jadsom, Eric Ramires (ou Raul) e Lucas Evangelista; Henry Mosquera, Vitinho (ou Lincoln) e Eduardo Sasha (ou Thiago Borbas).
                    </p>
                    <p>
                        <strong>Desfalques:</strong> O zagueiro Eduardo Santos e o volante Matheus Fernandes seguem no departamento médico do clube em recuperação de lesões no joelho e muscular.
                    </p>
                    <p>
                        <strong>Pendurados:</strong> Juninho Capixaba, Cleiton e Jadsom entram em campo sob risco de suspensão automática caso recebam advertência com cartão amarelo.
                    </p>
                    <p><strong>Técnico:</strong> Fernando Seabra.</p>
                </div>
            </div>

            <h2>Equipe de arbitragem confirmada pela CBF</h2>
            <p>
                A Confederação Brasileira de Futebol escalou Rodrigo José Pereira de Lima como árbitro principal para conduzir a partida no Maracanã:
            </p>
            <ul>
                <li><strong>Árbitro principal:</strong> Rodrigo José Pereira de Lima (PE)</li>
                <li><strong>Assistente 1:</strong> Bruno Boschilia (Fifa-PR)</li>
                <li><strong>Assistente 2:</strong> Francisco Chaves Bezerra Junior (PE)</li>
                <li><strong>Quarto árbitro:</strong> Paulo Belence Alves dos Prazeres Filho (PE)</li>
                <li><strong>Árbitro de vídeo (VAR):</strong> Marco Aurélio Augusto Fazekas Ferreira (MG)</li>
                <li><strong>Assistente de VAR (AVAR):</strong> Marcus Vinicius Gomes (MG)</li>
            </ul>
        </section>

        <section class="match-faq" aria-labelledby="perguntas-frequentes">
            <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
            {faq.map((item) => (
                <div class="faq-item">
                    <h3>{item.question}</h3>
                    <p>{item.answer}</p>
                </div>
            ))}
        </section>

        <footer class="match-footer">
            <p>
                Fontes oficiais e estatísticas: <a href="https://ge.globo.com/futebol/times/flamengo/" target="_blank" rel="noopener noreferrer">ge Flamengo</a>, <a href="https://ge.globo.com/sp/vale-do-paraiba-regiao/futebol/times/bragantino/" target="_blank" rel="noopener noreferrer">ge Red Bull Bragantino</a> e <a href="https://www.cbf.com.br/" target="_blank" rel="noopener noreferrer">Confederação Brasileira de Futebol (CBF)</a>.
            </p>
            <p>Este guia tático e informativo é atualizado conforme boletins médicos de última hora e confirmações oficiais das escalações antes da bola rolar.</p>
            <a href="/futebol/flamengo-x-corinthians-onde-assistir/">Veja também: Flamengo x Corinthians pelo Brasileirão</a>
            <a href="/futebol/flamengo-x-independiente-del-valle-onde-assistir/">Confira: Flamengo x Independiente del Valle pela Libertadores</a>
            <a href="/futebol/palmeiras-x-sao-paulo-onde-assistir/">Leia também: Palmeiras x São Paulo pelo Brasileirão</a>
            <a href="/futebol/">← Ver todos os jogos e notícias de futebol</a>
        </footer>
    </article>
</MainLayout>

<style>
    .match-article { max-width: 900px; margin: 0 auto; }
    .match-hero { margin-bottom: 1.5rem; }
    .match-kicker { margin: 0 0 0.5rem; color: #2563eb; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .match-hero h1 { margin: 0 0 0.6rem; color: #111827; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; }
    .match-updated { margin: 0; color: #6b7280; font-size: 0.9rem; }
    .match-cover { display: block; width: 100%; height: auto; margin-bottom: 1.5rem; border-radius: 12px; }
    .match-lead { margin: 0 0 1.5rem; color: #374151; font-size: 1.15rem; line-height: 1.75; }
    .match-summary { margin: 1.5rem 0 2rem; padding: 1.5rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; }
    .match-summary h2 { margin-top: 0; color: #1f2937; }
    .match-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
    .match-details div { padding: 0.9rem; background: #fff; border-radius: 8px; }
    .match-details dt { color: #6b7280; font-size: 0.85rem; font-weight: 700; }
    .match-details dd { margin: 0.3rem 0 0; color: #111827; font-weight: 600; }
    .match-content { color: #374151; font-size: 1.05rem; line-height: 1.8; }
    .match-content h2 { margin: 2.25rem 0 0.75rem; color: #1f2937; font-size: 1.5rem; }
    .match-content h3 { margin: 1.5rem 0 0.5rem; color: #1f2937; font-size: 1.25rem; }
    .match-content p { margin: 0 0 1rem; }
    .match-content ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
    .match-content li { margin-bottom: 0.5rem; }
    .lineups { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin: 1.25rem 0; }
    .team-lineup { padding: 1.25rem; background: #f3f4f6; border-radius: 10px; }
    .team-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
    .team-head img { width: 64px; height: 64px; object-fit: contain; }
    .team-head h3 { margin: 0; color: #1f2937; font-size: 1.35rem; }
    .team-lineup p { margin: 0 0 0.75rem; font-size: 0.98rem; line-height: 1.7; }
    .match-faq { margin: 2.5rem 0 0; }
    .match-faq h2 { color: #1f2937; }
    .faq-item { padding: 1rem 0; border-bottom: 1px solid #e5e7eb; }
    .faq-item h3 { margin: 0 0 0.4rem; color: #1f2937; font-size: 1.1rem; }
    .faq-item p { margin: 0; color: #4b5563; line-height: 1.7; }
    .match-footer { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 0.95rem; }
    .match-footer a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 0.2em; }
    @media (max-width: 640px) { .match-summary { padding: 1rem; } .match-content { font-size: 1rem; } }
</style>
