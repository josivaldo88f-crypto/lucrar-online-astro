---
import MainLayout from '../../layouts/MainLayout.astro';

export const title = 'Santos x Cruzeiro: Onde Assistir e Horário (Brasileirão)';
export const description = 'Santos x Cruzeiro jogam sábado (12/9), às 21h, na Vila Belmiro, na 27ª rodada do Brasileirão 2026. Veja onde assistir ao vivo, escalações e arbitragem.';
export const categoria = 'futebol';
export const date = '2026-09-11';
export const image = '/images/santos-x-cruzeiro-onde-assistir.webp';

const startDate = '2026-09-12T21:00:00-03:00';
const endDate = '2026-09-12T23:00:00-03:00';
const cover720 = image.replace(/\.webp$/, '-720.webp');

const faq = [
    {
        question: 'Onde assistir Santos x Cruzeiro ao vivo?',
        answer: 'A partida tem transmissão do SporTV na TV fechada e do Premiere no pay-per-view. O ge.globo acompanha em tempo real, lance a lance.',
    },
    {
        question: 'Que horas começa Santos x Cruzeiro?',
        answer: 'O apito inicial está marcado para 21h (horário de Brasília) deste sábado, 12 de setembro de 2026.',
    },
    {
        question: 'Onde será Santos x Cruzeiro?',
        answer: 'Na Vila Belmiro, o Estádio Urbano Caldeira, em Santos (SP), com mando de campo do Santos.',
    },
    {
        question: 'Quais são os desfalques de Santos e Cruzeiro?',
        answer: 'No Santos, Neymar, Lucas Veríssimo e Barreal seguem em tratamento, enquanto Gabigol e Escobar estão suspensos. No Cruzeiro, Sinisterra, Gabriel Pec e Jonathan Jesus seguem em tratamento.',
    },
    {
        question: 'Como foi o último Santos x Cruzeiro?',
        answer: 'As duas equipes empataram por 0 a 0 em 22 de março de 2026, pelo primeiro turno. No encontro anterior, em 7 de dezembro de 2025, o Santos venceu por 3 a 0.',
    },
    {
        question: 'Quem apita Santos x Cruzeiro?',
        answer: 'Bruno Arleu de Araújo (RJ) é o árbitro principal. Os assistentes são Nailton Junior de Sousa Oliveira (CE) e Thiago Henrique Neto Correa Farinha (RJ), com Heber Roberto Lopes (SC) no VAR.',
    },
];

const eventJson = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: 'Santos x Cruzeiro pelo Brasileirão 2026',
    description,
    startDate,
    endDate,
    sport: 'Futebol',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [new URL(image, Astro.site ?? 'https://www.lucrar.link/').href],
    url: new URL('futebol/santos-x-cruzeiro-onde-assistir/', Astro.site ?? 'https://www.lucrar.link/').href,
    location: {
        '@type': 'Place',
        name: 'Estádio Urbano Caldeira (Vila Belmiro)',
        address: {
            '@type': 'PostalAddress',
            addressLocality: 'Santos',
            addressRegion: 'SP',
            addressCountry: 'BR',
        },
    },
    competitor: [
        { '@type': 'SportsTeam', name: 'Santos' },
        { '@type': 'SportsTeam', name: 'Cruzeiro' },
    ],
    homeTeam: {
        '@type': 'SportsTeam',
        name: 'Santos',
    },
    awayTeam: {
        '@type': 'SportsTeam',
        name: 'Cruzeiro',
    },
    organizer: {
        '@type': 'Organization',
        name: 'Confederação Brasileira de Futebol',
        url: 'https://www.cbf.com.br/',
    },
});
---

<MainLayout
    seo={{ title, description, image, datePublished: date, dateModified: date, faq }}
    categoria={categoria}
    preloadImage={image}
    preloadImageSrcset={`${cover720} 720w, ${image} 1200w`}
    preloadImageSizes="(max-width: 900px) 92vw, 900px"
>
    <script slot="head" type="application/ld+json" set:html={eventJson}></script>

    <article class="match-article">
        <header class="match-hero">
            <p class="match-kicker">Brasileirão 2026 · 27ª rodada</p>
            <h1>{title}</h1>
            <p class="match-updated">Por Redação · Publicado em <time datetime={date}>11 de setembro de 2026</time></p>
        </header>

        <img
            class="match-cover"
            src={image}
            srcset={`${cover720} 720w, ${image} 1200w`}
            sizes="(max-width: 900px) 92vw, 900px"
            alt="Santos x Cruzeiro na Vila Belmiro pela 27ª rodada do Brasileirão 2026"
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />

        <p class="match-lead">
            Santos e Cruzeiro jogam neste sábado (12), às 21h (horário de Brasília), na Vila Belmiro, em Santos,
            pela 27ª rodada do Brasileirão Betano Série A 2026. A transmissão ao vivo fica com o SporTV, na TV
            fechada, e com o Premiere, no pay-per-view. O ge.globo acompanha lance a lance em tempo real. O Peixe
            joga em casa quatro dias antes da volta da Sul-Americana, enquanto o Cruzeiro, quarto colocado e dono
            da melhor campanha do returno, tenta se firmar no G4.
        </p>

        <section class="match-summary" aria-labelledby="ficha-do-jogo">
            <h2 id="ficha-do-jogo">Ficha do jogo</h2>
            <dl class="match-details">
                <div><dt>Data</dt><dd>Sábado, 12 de setembro de 2026</dd></div>
                <div><dt>Horário</dt><dd>21h (horário de Brasília)</dd></div>
                <div><dt>Estádio</dt><dd>Urbano Caldeira (Vila Belmiro)</dd></div>
                <div><dt>Local</dt><dd>Santos (SP)</dd></div>
                <div><dt>Transmissão</dt><dd>SporTV e Premiere</dd></div>
                <div><dt>Tempo Real</dt><dd>ge.globo</dd></div>
                <div><dt>Árbitro</dt><dd>Bruno Arleu de Araújo (RJ)</dd></div>
                <div><dt>VAR</dt><dd>Heber Roberto Lopes (SC)</dd></div>
            </dl>
        </section>

        <section class="match-content">
            <h2>Onde assistir Santos x Cruzeiro ao vivo</h2>
            <p>
                O jogo tem sinal fechado e pay-per-view. Quem não assina TV por assinatura pode acompanhar os
                lances pelo tempo real do ge.globo e pelas rádios que transmitem para Belo Horizonte:
            </p>
            <ul>
                <li>
                    <strong>SporTV:</strong> canal da TV fechada exibe a partida para assinantes das principais
                    operadoras do país, com pré-jogo e análise no intervalo.
                </li>
                <li>
                    <strong>Premiere:</strong> transmite em pay-per-view no sistema de TV por assinatura e também
                    pelo aplicativo, para quem contrata o pacote de futebol.
                </li>
                <li>
                    <strong>ge.globo:</strong> faz a cobertura minuto a minuto, publica os vídeos dos gols e reúne
                    estatísticas de posse de bola, finalizações e faltas.
                </li>
                <li>
                    <strong>Rádios:</strong> Itatiaia, 98 FM, BandNews FM e CBN levam a transmissão para a praça de
                    Belo Horizonte. O TEMPO e O TEMPO Sports fazem cobertura em vídeo no YouTube.
                </li>
            </ul>

            <h2>Santos administra o desgaste e tenta embalar de novo</h2>
            <p>
                O Santos entra em campo em recuperação no Brasileirão. O time é o 13º colocado, com 32 pontos, mas
                vem de duas vitórias seguidas na competição. No meio da semana, bateu o Atlético-MG por 2 a 0 na
                Vila Belmiro, na partida de ida das quartas de final da Copa Sul-Americana.
            </p>
            <p>
                O Peixe volta a campo na quarta-feira (16), às 19h, contra o Atlético-MG, na Arena MRV, pela volta
                da Sul-Americana. Como venceu a ida em casa por 2 a 0, o time de Cuca joga pelo empate em Belo
                Horizonte. O jogo de sábado mexe com essa conta: Cuca deve poupar os mais desgastados, e Everton
                Cebolinha, recém-contratado, surge como alternativa no ataque.
            </p>
            <p>
                No returno, o Santos tem a 5ª melhor campanha, com três vitórias, dois empates e uma derrota. A
                eliminação na Copa do Brasil, diante do <a href="/futebol/palmeiras-x-sao-paulo-onde-assistir/">Palmeiras</a>,
                tirou uma frente do caminho e deixou o Brasileirão como prioridade. Em 13º, o time ainda precisa de
                pontos para se afastar da parte de baixo da tabela.
            </p>
            <p>
                Neymar e Barreal são baixas na criação e no ataque, e sem Gabigol o Santos perde a referência na
                área. Escobar, suspenso, era opção pela lateral esquerda. Cuca deve montar a frente com Thaciano e
                Caballero e usar Everton Cebolinha no decorrer da partida.
            </p>

            <h2>Cruzeiro chega com a melhor campanha do returno e defende o G4</h2>
            <p>
                A Raposa é dona da melhor campanha do segundo turno: cinco vitórias, nenhum empate e duas derrotas.
                O time é o 4º colocado, com 42 pontos, e bateu o Athletico-PR por 3 a 1 na última rodada. Um
                resultado positivo na Vila Belmiro mantém a equipe de Artur Jorge na zona de classificação e
                pressiona os concorrentes diretos.
            </p>
            <p>
                Restou apenas o Brasileirão: o Cruzeiro foi eliminado da Copa do Brasil pelo Atlético-MG e da
                Libertadores nas oitavas de final. Sem jogo no meio da semana, Artur Jorge teve a semana livre para
                treinar. O próximo compromisso depois de sábado é em 20 de setembro, contra o Vitória, no Barradão,
                pela 26ª rodada — partida atrasada.
            </p>
            <p>
                O clube anunciou o lateral Matías Viña, mas o reforço não joga nesta partida. Para o duelo em
                Santos, o Cruzeiro não terá Sinisterra, Gabriel Pec e Jonathan Jesus, todos em tratamento. Ninguém
                está suspenso, mas seis atletas entram pendurados: Otávio, João Marcelo, Villalba, Kauã Moraes,
                Lucas Silva e Wesley. O terceiro amarelo tira qualquer um deles do jogo contra o Vitória.
            </p>
            <p>
                Sem Sinisterra e Gabriel Pec, o Cruzeiro perde velocidade pelos lados. Keny Arroyo e Matheus
                Pereira ficam responsáveis pela criação, com Kaio Jorge como homem de área. Na lateral esquerda,
                Gabriel Rojas e Lucas Villalba disputam a posição.
            </p>

            <h2>Desfalques e prováveis escalações</h2>
            <div class="lineups">
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-santos.webp" alt="Escudo do Santos" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Santos</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Gabriel Brazão; Rodinei, Willian Arão, Ananias (Lucas
                        Veríssimo) e Luan Peres (Rafael Gonzaga ou Igor Vinícius); Christian Oliva, Gustavinho
                        (João Schmidt), Benjamín Rollheiser e Bontempo (Arthur); Gustavo Caballero (Everton
                        Cebolinha) e Thaciano.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> Neymar, Lucas Veríssimo e Álvaro Barreal seguem em tratamento
                        no departamento médico. Gabigol, que pertence ao Cruzeiro e não pode enfrentar o clube dono
                        do seu passe, e Gonzalo Escobar estão suspensos.
                    </p>
                    <p><strong>Técnico:</strong> Cuca.</p>
                </div>
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-cruzeiro.webp" alt="Escudo do Cruzeiro" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Cruzeiro</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Otávio; Fagner, Fabrício Bruno, João Marcelo e Gabriel
                        Rojas (Lucas Villalba); Lucas Romero, Gerson, Matheus Henrique e Matheus Pereira; Keny
                        Arroyo e Kaio Jorge.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> Luis Sinisterra, Gabriel Pec e Jonathan Jesus estão em
                        tratamento. Nenhum jogador está suspenso para esta rodada.
                    </p>
                    <p>
                        <strong>Pendurados:</strong> Otávio, João Marcelo, Villalba, Kauã Moraes, Lucas Silva e
                        Wesley levam dois amarelos e precisam de cautela para não desfalcar o time na próxima
                        partida.
                    </p>
                    <p><strong>Técnico:</strong> Artur Jorge.</p>
                </div>
            </div>
            <p>
                Na defesa, a dúvida é ao lado de Willian Arão: Ananias deve seguir como titular, já que Lucas
                Veríssimo continua em tratamento. Na lateral esquerda, Luan Peres aparece à frente de Rafael Gonzaga
                e Igor Vinícius. No meio, Arthur e João Schmidt brigam por espaço; no ataque, Everton Cebolinha é a
                alternativa a Caballero.
            </p>

            <h2>Equipe de arbitragem</h2>
            <p>
                Bruno Arleu de Araújo (RJ) é o árbitro principal da partida. Ele terá como assistentes Nailton
                Junior de Sousa Oliveira (CE) e Thiago Henrique Neto Correa Farinha (RJ). O VAR fica com Heber
                Roberto Lopes (SC).
            </p>

            <h2>Retrospecto do confronto</h2>
            <p>
                Santos e Cruzeiro já se enfrentaram 79 vezes na história. O Cruzeiro venceu 31, o Santos ganhou 27
                e houve 21 empates. Como mandante, o Peixe tem leve vantagem: em 42 partidas, foram 18 vitórias
                santistas, 17 cruzeirenses e sete empates.
            </p>
            <p>
                O último encontro terminou em 0 a 0, em 22 de março de 2026, pelo primeiro turno do Brasileirão. No
                duelo anterior, em 7 de dezembro de 2025, o Santos venceu por 3 a 0.
            </p>

            <h2>Ingressos</h2>
            <p>
                No setor visitante, o ingresso custa R$ 80 (inteira) e R$ 40 (meia). A venda segue pelos
                <a href="https://www.santosfc.com.br/" rel="noopener noreferrer">canais oficiais do Santos</a>,
                dono do mando de campo. Os valores podem mudar; confira a página do clube antes da compra.
            </p>

            <h2>Próximos jogos</h2>
            <ul>
                <li><strong>Santos:</strong> 16/09 (quarta), às 19h, contra o Atlético-MG, na Arena MRV, pela volta das quartas de final da Copa Sul-Americana.</li>
                <li><strong>Cruzeiro:</strong> 20/09 (domingo), às 16h, contra o Vitória, no Barradão, pela 26ª rodada do Brasileirão (jogo atrasado).</li>
            </ul>
        </section>

        <section class="match-faq" aria-labelledby="perguntas-frequentes">
            <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
            {faq.map((item) => (
                <div class="faq-item">
                    <h3>{item.question}</h3>
                    <p>{item.answer}</p>
                </div>
            ))}
        </section>

        <footer class="match-footer">
            <p>
                Fontes oficiais: <a href="https://ge.globo.com/futebol/times/santos/" rel="noopener noreferrer">ge Santos</a>, <a href="https://ge.globo.com/futebol/times/cruzeiro/" rel="noopener noreferrer">ge Cruzeiro</a> e <a href="https://www.cbf.com.br/" rel="noopener noreferrer">Confederação Brasileira de Futebol (CBF)</a>.
            </p>
            <p>Este guia informativo é atualizado conforme novos boletins médicos ou alterações na escala oficial forem divulgados.</p>
            <a href="/futebol/palmeiras-x-sao-paulo-onde-assistir/">Veja também: Palmeiras x São Paulo pelo Brasileirão</a>
            <a href="/futebol/flamengo-x-corinthians-onde-assistir/">Veja também: Flamengo x Corinthians no Maracanã</a>
            <a href="/futebol/">← Ver todos os jogos e notícias de futebol</a>
        </footer>
    </article>
</MainLayout>

<style>
    .match-article { max-width: 900px; margin: 0 auto; }
    .match-hero { margin-bottom: 1.5rem; }
    .match-kicker { margin: 0 0 0.5rem; color: #2563eb; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .match-hero h1 { margin: 0 0 0.6rem; color: #111827; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; }
    .match-updated { margin: 0; color: #6b7280; font-size: 0.9rem; }
    .match-cover { display: block; width: 100%; height: auto; margin-bottom: 1.5rem; border-radius: 12px; }
    .match-lead { margin: 0 0 1.5rem; color: #374151; font-size: 1.15rem; line-height: 1.75; }
    .match-summary { margin: 1.5rem 0 2rem; padding: 1.5rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; }
    .match-summary h2 { margin-top: 0; color: #1f2937; }
    .match-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
    .match-details div { padding: 0.9rem; background: #fff; border-radius: 8px; }
    .match-details dt { color: #6b7280; font-size: 0.85rem; font-weight: 700; }
    .match-details dd { margin: 0.3rem 0 0; color: #111827; font-weight: 600; }
    .match-content { color: #374151; font-size: 1.05rem; line-height: 1.8; }
    .match-content h2 { margin: 2.25rem 0 0.75rem; color: #1f2937; font-size: 1.5rem; }
    .match-content h3 { margin: 1.5rem 0 0.5rem; color: #1f2937; font-size: 1.25rem; }
    .match-content p { margin: 0 0 1rem; }
    .match-content ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
    .match-content li { margin-bottom: 0.5rem; }
    .lineups { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin: 1.25rem 0; }
    .team-lineup { padding: 1.25rem; background: #f3f4f6; border-radius: 10px; }
    .team-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
    .team-head img { width: 64px; height: 64px; object-fit: contain; }
    .team-head h3 { margin: 0; color: #1f2937; font-size: 1.35rem; }
    .team-lineup p { margin: 0 0 0.75rem; font-size: 0.98rem; line-height: 1.7; }
    .match-faq { margin: 2.5rem 0 0; }
    .match-faq h2 { color: #1f2937; }
    .faq-item { padding: 1rem 0; border-bottom: 1px solid #e5e7eb; }
    .faq-item h3 { margin: 0 0 0.4rem; color: #1f2937; font-size: 1.1rem; }
    .faq-item p { margin: 0; color: #4b5563; line-height: 1.7; }
    .match-footer { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 0.95rem; }
    .match-footer a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 0.2em; }
    @media (max-width: 640px) { .match-summary { padding: 1rem; } .match-content { font-size: 1rem; } }
</style>
