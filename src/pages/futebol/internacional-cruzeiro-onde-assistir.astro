---
import MatchArticle from '../../components/MatchArticle.astro';

export const title = 'Internacional x Cruzeiro: Onde Assistir (22/7)';
export const description = 'Saiba onde assistir Internacional x Cruzeiro em 22 de julho pelo Brasileirão 2026: horário, Beira-Rio e transmissão ao vivo.';
export const date = '2026-07-21';
export const image = '/images/brasileirao-onde-assistir.webp';
---
<MatchArticle
    title={title}
    description={description}
    datePublished="2026-07-21"
    matchDate="22 de julho de 2026 (quarta-feira)"
    startDate="2026-07-22T21:30:00-03:00"
    time="21h30"
    round="19ª rodada"
    homeTeam="Internacional"
    awayTeam="Cruzeiro"
    venue="Beira-Rio"
    city="Porto Alegre (RS)"
    broadcast="Globo e Premiere"
    newsTitle="Duelo no Beira-Rio fecha a noite de jogos"
    newsText="Internacional x Cruzeiro está entre os confrontos de 21h30 programados para a quarta-feira. A tabela detalhada informa o Beira-Rio como palco e a transmissão na Globo e no Premiere."
    sourceUrl="https://ge.globo.com/ba/futebol/brasileirao-serie-a/noticia/2026/07/16/brasileirao-2026-veja-onde-assistir-ao-vivo-aos-jogos-da-19a-rodada.ghtml"
    sourceLabel="ge"
/>
