---
import MatchArticle from '../../components/MatchArticle.astro';

export const title = 'Atlético-MG x Bahia: Onde Assistir Hoje (21/7)';
export const description = 'Veja onde assistir Atlético-MG x Bahia hoje, 21 de julho, pelo Brasileirão 2026: horário, Arena MRV e canais de transmissão.';
export const date = '2026-07-21';
export const image = '/images/brasileirao-onde-assistir.webp';
---
<MatchArticle
    title={title}
    description={description}
    datePublished="2026-07-21"
    matchDate="21 de julho de 2026 (terça-feira)"
    startDate="2026-07-21T19:30:00-03:00"
    time="19h30"
    round="19ª rodada"
    homeTeam="Atlético-MG"
    awayTeam="Bahia"
    venue="Arena MRV"
    city="Belo Horizonte (MG)"
    broadcast="SporTV e Premiere"
    newsTitle="Atlético tenta se aproximar do G-5 em casa"
    newsText="A partida coloca frente a frente equipes em momentos diferentes: o Atlético busca aproveitar o mando de campo, enquanto o Bahia chega após duas vitórias no campeonato."
    sourceUrl="https://www.bol.uol.com.br/esporte/2026/07/21/atletico-mg-x-bahia-horario-e-onde-assistir-ao-jogo-do-brasileirao.amp.htm"
    sourceLabel="UOL Esporte"
/>
