---
import MainLayout from '../../layouts/MainLayout.astro';

export const title = 'Flamengo x Corinthians: Onde Assistir e Horário (Brasileirão)';
export const description = 'Flamengo x Corinthians duelam domingo (13/9), às 17h30, no Maracanã, pelo Brasileirão 2026. Saiba onde assistir ao vivo, horários, escalações e arbitragem.';
export const categoria = 'futebol';
export const date = '2026-09-11';
export const image = '/images/flamengo-x-corinthians-onde-assistir.webp';

const startDate = '2026-09-13T17:30:00-03:00';
const endDate = '2026-09-13T19:30:00-03:00';
const cover720 = image.replace(/\.webp$/, '-720.webp');

const faq = [
    {
        question: 'Onde assistir Flamengo x Corinthians ao vivo?',
        answer: 'A partida terá transmissão ao vivo da TV Globo em sinal aberto para a maior parte do país e do canal Premiere no pay-per-view e no Globoplay. O portal ge.globo acompanha lance a lance em tempo real.',
    },
    {
        question: 'Que horas começa o jogo Flamengo x Corinthians?',
        answer: 'O confronto tem início marcado para 17h30 (horário de Brasília) deste domingo, 13 de setembro de 2026.',
    },
    {
        question: 'Onde será a partida entre Flamengo e Corinthians?',
        answer: 'O clássico será disputado no Estádio Jornalista Mário Filho, o Maracanã, no Rio de Janeiro (RJ).',
    },
    {
        question: 'Quais são os principais desfalques das duas equipes?',
        answer: 'No Flamengo, o zagueiro Léo Ortiz cumpre suspensão automática pelo acúmulo de três cartões amarelos. No Corinthians, o volante Alex Santana também está fora por suspensão.',
    },
    {
        question: 'Como foram os confrontos entre os clubes em 2026?',
        answer: 'O Corinthians superou o Flamengo por 2 a 0 em fevereiro na decisão da Supercopa Rei e as duas equipes empataram por 1 a 1 na Neo Química Arena pelo primeiro turno da Série A.',
    },
    {
        question: 'Quem é a equipe de arbitragem do clássico?',
        answer: 'O árbitro principal é Wilton Pereira Sampaio (Fifa-GO), com os assistentes Bruno Raphael Pires (Fifa-GO) e Bruno Boschilia (Fifa-PR). O comando do VAR fica com Rodolpho Toski Marques (Fifa-PR).',
    },
];

const eventJson = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: 'Flamengo x Corinthians pelo Brasileirão 2026',
    description,
    startDate,
    endDate,
    sport: 'Futebol',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: [new URL(image, Astro.site ?? 'https://www.lucrar.link/').href],
    location: {
        '@type': 'Place',
        name: 'Estádio Jornalista Mário Filho (Maracanã)',
        address: {
            '@type': 'PostalAddress',
            addressLocality: 'Rio de Janeiro',
            addressRegion: 'RJ',
            addressCountry: 'BR',
        },
    },
    competitor: [
        { '@type': 'SportsTeam', name: 'Flamengo' },
        { '@type': 'SportsTeam', name: 'Corinthians' },
    ],
    homeTeam: {
        '@type': 'SportsTeam',
        name: 'Flamengo',
    },
    awayTeam: {
        '@type': 'SportsTeam',
        name: 'Corinthians',
    },
    organizer: {
        '@type': 'Organization',
        name: 'Confederação Brasileira de Futebol',
        url: 'https://www.cbf.com.br/',
    },
});
---

<MainLayout
    seo={{ title, description, image, datePublished: date, dateModified: date, faq }}
    categoria={categoria}
    preloadImage={image}
    preloadImageSrcset={`${cover720} 720w, ${image} 1200w`}
    preloadImageSizes="(max-width: 900px) 92vw, 900px"
>
    <script slot="head" type="application/ld+json" set:html={eventJson}></script>

    <article class="match-article">
        <header class="match-hero">
            <p class="match-kicker">Brasileirão 2026 · 27ª rodada · Clássico das Multidões</p>
            <h1>{title}</h1>
            <p class="match-updated">Por Redação · Publicado em <time datetime={date}>11 de setembro de 2026</time></p>
        </header>

        <img
            class="match-cover"
            src={image}
            srcset={`${cover720} 720w, ${image} 1200w`}
            sizes="(max-width: 900px) 92vw, 900px"
            alt="Flamengo x Corinthians no Maracanã pela 27ª rodada do Brasileirão 2026"
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />

        <p class="match-lead">
            Flamengo e Corinthians duelam neste domingo (13), às 17h30 (horário de Brasília), no Maracanã, pela 27ª rodada do Campeonato Brasileiro 2026. O tradicional Clássico das Multidões reúne as duas maiores torcidas do país com transmissão ao vivo da TV Globo na TV aberta e do Premiere no pay-per-view. O confronto marca a abertura do terço decisivo do segundo turno da Série A: o Rubro-Negro entra em campo para defender a liderança isolada, enquanto o Timão tenta manter a escrita de algoz do rival em 2026.
        </p>

        <section class="match-summary" aria-labelledby="ficha-do-jogo">
            <h2 id="ficha-do-jogo">Ficha do jogo</h2>
            <dl class="match-details">
                <div><dt>Data</dt><dd>Domingo, 13 de setembro de 2026</dd></div>
                <div><dt>Horário</dt><dd>17h30 (horário de Brasília)</dd></div>
                <div><dt>Estádio</dt><dd>Maracanã</dd></div>
                <div><dt>Local</dt><dd>Rio de Janeiro (RJ)</dd></div>
                <div><dt>Transmissão</dt><dd>TV Globo e Premiere</dd></div>
                <div><dt>Tempo Real</dt><dd>ge.globo</dd></div>
                <div><dt>Árbitro</dt><dd>Wilton Pereira Sampaio (Fifa-GO)</dd></div>
                <div><dt>VAR</dt><dd>Rodolpho Toski Marques (Fifa-PR)</dd></div>
            </dl>
        </section>

        <section class="match-content">
            <h2>Onde assistir Flamengo x Corinthians ao vivo</h2>
            <p>
                O torcedor tem opções gratuitas na TV aberta e sinal fechado por assinatura para acompanhar o clássico interestadual deste domingo:
            </p>
            <ul>
                <li>
                    <strong>TV Globo:</strong> transmite ao vivo na TV aberta para o Rio de Janeiro, São Paulo e a maior parte da rede nacional logo após a programação vespertina, com equipe completa de narração e comentaristas titulares.
                </li>
                <li>
                    <strong>Premiere:</strong> exibe o confronto em pay-per-view com imagem em alta definição para todo o país nas principais operadoras de TV por assinatura (Claro TV, Sky, Vivo Play e Oi TV), além do sinal online no aplicativo Premiere e pelo streaming do Globoplay para assinantes do pacote futebol.
                </li>
                <li>
                    <strong>ge.globo:</strong> faz a cobertura completa minuto a minuto em tempo real, disponibilizando vídeos dos gols e das jogadas capitais logo após os lances, estatísticas detalhadas de posse e finalizações, além da avaliação da Central do Apito.
                </li>
            </ul>

            <h2>A matemática da ponta e a sombra do Choque-Rei</h2>
            <p>
                O Flamengo entra na 27ª rodada sustentando a liderança isolada da Série A com 54 pontos. A tabela esquenta ainda mais o duelo: o Rubro-Negro já pisa no gramado sabendo o resultado final do clássico entre <a href="/futebol/palmeiras-x-sao-paulo-onde-assistir/">Palmeiras e São Paulo</a>, disputado no sábado.
            </p>
            <p>
                O Palmeiras iniciou o fim de semana colado no retrovisor com 53 pontos. Se o Alviverde bater o rival tricolor no Choque-Rei de sábado, assume a ponta de forma provisória com 56 pontos e joga toda a carga de pressão para as costas da equipe comandada por Filipe Luís no domingo. Por outro lado, caso o São Paulo consiga arrancar pontos no Allianz, o Flamengo terá a chance de ouro de abrir até quatro pontos de folga no topo da tabela.
            </p>
            <p>
                Pelo lado do Corinthians, a ambição no segundo turno mira uma vaga direta na fase de grupos da Copa Libertadores da América. Sob a batuta de Fernando Diniz, o Timão engatou uma sequência consistente e busca afirmação definitiva no G-6, ciente de que pontuar no Maracanã diante do líder é o combustível necessário para a arrancada final da temporada.
            </p>

            <h2>Clima de revanche no Maracanã em 2026</h2>
            <p>
                Mais do que três pontos pesados na corrida pelo troféu, a partida carrega sabor de revanche entalada na garganta dos cariocas. O retrospecto de 2026 é amplamente favorável aos paulistas: o Flamengo ainda não sabe o que é vencer o Corinthians neste ano.
            </p>
            <p>
                Em fevereiro, os dois clubes decidiram a Supercopa Rei no Mineirão. Naquela tarde em Belo Horizonte, o Timão neutralizou as investidas ofensivas rubro-negras, castigou em contragolpes rápidos e levantou a taça com uma vitória categórica por 2 a 0. Meses mais tarde, pelo primeiro turno do Brasileirão, as equipes travaram um duelo de nervos à flor da pele na Neo Química Arena, terminando empatadas em 1 a 1 com direito a divididas ríspidas e muita reclamação com a arbitragem.
            </p>
            <p>
                Empurrado por mais de 60 mil ingressos vendidos no Maracanã, o Mengão quer dar o troco diante de sua torcida, quebrar a invencibilidade do rival alvinegro no confronto direto em 2026 e afastar qualquer fantasma de freguesia na temporada.
            </p>

            <h2>Confronto tático: a saída curta com os pés de Hugo Souza contra a pressão alta</h2>
            <p>
                No gramado, o choque de conceitos entre Filipe Luís e Fernando Diniz dita a temperatura do clássico. Diniz não abre mão da sua cartilha: aposta na <strong>saída curta</strong> trabalhada desde a pequena área, e o goleiro <strong>Hugo Souza</strong> virou a peça-chave dessa engrenagem.
            </p>
            <p>
                Cria do Ninho do Urubu e adquirido em definitivo pelo Parque São Jorge, Hugo vive grande fase técnica e reencontra o clube formador no Maracanã sob os holofotes da famosa "lei do ex". Com os pés, o arqueiro joga adiantado quase como um terceiro zagueiro, chamando os atacantes adversários para a pequena área com o objetivo de gerar superioridade numérica na primeira fase de construção e achar passes verticais rasteiros para os volantes e os meias de criação.
            </p>
            <p>
                A armadilha, porém, funciona nos dois sentidos. O Flamengo desenhou seu plano para sufocar o rival em <strong>bloco alto</strong>, encurtando o espaço de passe dos zagueiros e forçando o passe apressado do goleiro corintiano. Se o Corinthians conseguir furar a primeira onda de pressão com toques rápidos, terá campo aberto para acelerar em velocidade; mas se o Rubro-Negro morder a saída e roubar a posse no terço final, fica a dois toques de deixar seus artilheiros cara a cara com o gol.
            </p>

            <h2>Desfalques, pendurados e prováveis escalações</h2>
            <div class="lineups">
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-flamengo.webp" alt="Escudo do Flamengo" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Flamengo</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Rossi; Varela (ou Wesley), Fabrício Bruno, Léo Pereira e Ayrton Lucas; Erick Pulgar, De la Cruz e Arrascaeta; Gerson, Everton Cebolinha (ou Bruno Henrique) e Pedro.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> O zagueiro Léo Ortiz cumpre suspensão automática pelo terceiro cartão amarelo recebido na rodada passada. O departamento médico rubro-negro também monitora o desgaste físico de jogadores que atuaram os 90 minutos em compromissos de seleções.
                    </p>
                    <p>
                        <strong>Pendurados:</strong> Ayrton Lucas, Erick Pulgar e Gerson acumulam dois cartões amarelos e precisam de cautela redobrada para não virarem baixas na rodada seguinte.
                    </p>
                    <p><strong>Técnico:</strong> Filipe Luís.</p>
                </div>
                <div class="team-lineup">
                    <div class="team-head">
                        <img src="/images/escudo-corinthians.webp" alt="Escudo do Corinthians" width="64" height="64" loading="lazy" decoding="async" />
                        <h3>Corinthians</h3>
                    </div>
                    <p>
                        <strong>Provável escalação:</strong> Hugo Souza; Fagner (ou Matheuzinho), André Ramalho, Gustavo Henrique e Matheus Bidu; Raniele, Charles (ou Breno Bidon), Rodrigo Garro e André Carrillo; Memphis Depay e Yuri Alberto.
                    </p>
                    <p>
                        <strong>Desfalques:</strong> O meio-campista Alex Santana está suspenso pelo acúmulo de três cartões amarelos. Jogadores em processo de transição física seguem cronograma específico com a fisioterapia do CT Joaquim Grava.
                    </p>
                    <p>
                        <strong>Pendurados:</strong> Rodrigo Garro, Raniele e Fagner entram em campo pendurados com dois amarelos e estão sob risco de suspensão caso sejam advertidos.
                    </p>
                    <p><strong>Técnico:</strong> Fernando Diniz.</p>
                </div>
            </div>
            <p>
                No Flamengo, a baixa de Ortiz abre caminho natural para a reedição da zaga com Fabrício Bruno e Léo Pereira, dois defensores velozes para proteger a profundidade contra bolas esticadas. Já no meio-campo alvinegro, a ausência da pegada de Alex Santana obriga Diniz a decidir: colocar Breno Bidon para qualificar o passe curto e cadenciar o jogo ou apostar na marcação posicional mais combativa de Charles para fechar os espaços de Arrascaeta e De la Cruz.
            </p>

            <h2>Equipe de arbitragem confirmada</h2>
            <p>
                A comissão de arbitragem da CBF designou um quadro experiente para o clássico interestadual:
            </p>
            <ul>
                <li><strong>Árbitro principal:</strong> Wilton Pereira Sampaio (Fifa-GO)</li>
                <li><strong>Assistente 1:</strong> Bruno Raphael Pires (Fifa-GO)</li>
                <li><strong>Assistente 2:</strong> Bruno Boschilia (Fifa-PR)</li>
                <li><strong>Quarto árbitro:</strong> Jefferson Ferreira de Moraes (GO)</li>
                <li><strong>Árbitro de vídeo (VAR):</strong> Rodolpho Toski Marques (Fifa-PR)</li>
                <li><strong>Assistente de VAR (AVAR):</strong> Lilian da Silva Fernandes Bruno (RJ)</li>
            </ul>
        </section>

        <section class="match-faq" aria-labelledby="perguntas-frequentes">
            <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
            {faq.map((item) => (
                <div class="faq-item">
                    <h3>{item.question}</h3>
                    <p>{item.answer}</p>
                </div>
            ))}
        </section>

        <footer class="match-footer">
            <p>
                Fontes oficiais: <a href="https://ge.globo.com/futebol/times/flamengo/" rel="noopener noreferrer">ge Flamengo</a>, <a href="https://ge.globo.com/futebol/times/corinthians/" rel="noopener noreferrer">ge Corinthians</a> e <a href="https://www.cbf.com.br/" rel="noopener noreferrer">Confederação Brasileira de Futebol (CBF)</a>.
            </p>
            <p>Este guia informativo é atualizado conforme novos boletins médicos ou alterações na escala oficial forem divulgados.</p>
            <a href="/futebol/palmeiras-x-sao-paulo-onde-assistir/">Veja também: Palmeiras x São Paulo pelo Brasileirão</a>
            <a href="/futebol/">← Ver todos os jogos e notícias de futebol</a>
        </footer>
    </article>
</MainLayout>

<style>
    .match-article { max-width: 900px; margin: 0 auto; }
    .match-hero { margin-bottom: 1.5rem; }
    .match-kicker { margin: 0 0 0.5rem; color: #2563eb; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .match-hero h1 { margin: 0 0 0.6rem; color: #111827; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; }
    .match-updated { margin: 0; color: #6b7280; font-size: 0.9rem; }
    .match-cover { display: block; width: 100%; height: auto; margin-bottom: 1.5rem; border-radius: 12px; }
    .match-lead { margin: 0 0 1.5rem; color: #374151; font-size: 1.15rem; line-height: 1.75; }
    .match-summary { margin: 1.5rem 0 2rem; padding: 1.5rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; }
    .match-summary h2 { margin-top: 0; color: #1f2937; }
    .match-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
    .match-details div { padding: 0.9rem; background: #fff; border-radius: 8px; }
    .match-details dt { color: #6b7280; font-size: 0.85rem; font-weight: 700; }
    .match-details dd { margin: 0.3rem 0 0; color: #111827; font-weight: 600; }
    .match-content { color: #374151; font-size: 1.05rem; line-height: 1.8; }
    .match-content h2 { margin: 2.25rem 0 0.75rem; color: #1f2937; font-size: 1.5rem; }
    .match-content h3 { margin: 1.5rem 0 0.5rem; color: #1f2937; font-size: 1.25rem; }
    .match-content p { margin: 0 0 1rem; }
    .match-content ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
    .match-content li { margin-bottom: 0.5rem; }
    .lineups { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin: 1.25rem 0; }
    .team-lineup { padding: 1.25rem; background: #f3f4f6; border-radius: 10px; }
    .team-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
    .team-head img { width: 64px; height: 64px; object-fit: contain; }
    .team-head h3 { margin: 0; color: #1f2937; font-size: 1.35rem; }
    .team-lineup p { margin: 0 0 0.75rem; font-size: 0.98rem; line-height: 1.7; }
    .match-faq { margin: 2.5rem 0 0; }
    .match-faq h2 { color: #1f2937; }
    .faq-item { padding: 1rem 0; border-bottom: 1px solid #e5e7eb; }
    .faq-item h3 { margin: 0 0 0.4rem; color: #1f2937; font-size: 1.1rem; }
    .faq-item p { margin: 0; color: #4b5563; line-height: 1.7; }
    .match-footer { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 0.95rem; }
    .match-footer a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 0.2em; }
    @media (max-width: 640px) { .match-summary { padding: 1rem; } .match-content { font-size: 1rem; } }
</style>
