---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = await Astro.glob('./*.astro');
const categoryPosts = posts
    .filter(post => {
        const title = post.title || post.frontmatter?.title;
        // Ignora a própria página de índice e posts sem título
        return post.url && title && post.url !== Astro.url.pathname && post.url !== Astro.url.pathname + '/';
    })
    .sort((a, b) => {
        const dateA = new Date(a.date || a.frontmatter?.date || '0').getTime();
        const dateB = new Date(b.date || b.frontmatter?.date || '0').getTime();
        return dateB - dateA;
    });

const categoria = "futebol";
const image = "/images/brasileirao-onde-assistir.webp";
const title = "Jogos do Brasileirão e Onde Assistir";
const description = "Confira as últimas notícias, análises e onde assistir aos jogos de futebol.";
---

<MainLayout seo={{ title, description, image }} categoria={categoria} showRelacionados={false}>
    <h1 class="page-title" style="margin-bottom: 2rem; color: #2563eb;">{title}</h1>
    
    <section class="category-intro">
        <p>Acompanhe as <strong>notícias, análises e guias completos</strong> sobre futebol brasileiro e internacional. De clássicos regionais a campeonatos mundiais, trazemos informações sobre onde assistir, escalações, retrospectos e curiosidades. Seja você torcedor apaixonado ou fã de esportes, nosso conteúdo de futebol é feito para quem vive o esporte.</p>
    </section>
    <section class="match-agenda" aria-labelledby="match-agenda-title">
        <h2 id="match-agenda-title">Jogos do Brasileirão hoje e amanhã</h2>
        <p>Confira os guias atualizados com horário, local, transmissão e um destaque importante de cada partida.</p>
        <div class="agenda-grid">
            <a href="/futebol/atletico-mg-bahia-onde-assistir/"><strong>Hoje, 21/7:</strong> Atlético-MG x Bahia</a>
            <a href="/futebol/coritiba-palmeiras-onde-assistir/"><strong>Amanhã, 22/7:</strong> Coritiba x Palmeiras</a>
            <a href="/futebol/chapecoense-flamengo-onde-assistir/"><strong>Amanhã, 22/7:</strong> Chapecoense x Flamengo</a>
            <a href="/futebol/sao-paulo-athletico-pr-onde-assistir/"><strong>Amanhã, 22/7:</strong> São Paulo x Athletico-PR</a>
            <a href="/futebol/internacional-cruzeiro-onde-assistir/"><strong>Amanhã, 22/7:</strong> Internacional x Cruzeiro</a>
        </div>
    </section>
    
    <div class="posts-grid">
        {categoryPosts.map(post => {
            const title = post.title || post.frontmatter?.title;
            const description = post.description || post.frontmatter?.description;
            const image = post.image || post.frontmatter?.image || '/images/default-post.webp';
            const date = post.date || post.frontmatter?.date;
            
            return (
                <PostCard 
                    title={title}
                    description={description}
                    url={post.url}
                    image={image}
                    date={date}
                />
            );
        })}
    </div>
</MainLayout>

<style>
    .match-agenda { margin: 2rem 0; padding: 1.5rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; }
    .match-agenda h2 { margin: 0 0 0.5rem; color: #1f2937; }
    .match-agenda p { margin: 0 0 1rem; color: #4b5563; }
    .agenda-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.75rem; }
    .agenda-grid a { padding: 0.85rem 1rem; color: #1d4ed8; background: #fff; border-radius: 8px; text-decoration: none; }
    .agenda-grid a:hover { text-decoration: underline; }
</style>
