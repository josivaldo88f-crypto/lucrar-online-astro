---
import MatchArticle from '../../components/MatchArticle.astro';

export const title = 'Coritiba x Palmeiras: Onde Assistir (22/7)';
export const description = 'Saiba onde assistir Coritiba x Palmeiras em 22 de julho pelo Brasileirão 2026, com horário, Couto Pereira e transmissão no Prime Video.';
export const date = '2026-07-21';
export const image = '/images/brasileirao-onde-assistir.webp';
---
<MatchArticle
    title={title}
    description={description}
    datePublished="2026-07-21"
    matchDate="22 de julho de 2026 (quarta-feira)"
    startDate="2026-07-22T19:30:00-03:00"
    time="19h30"
    round="19ª rodada"
    homeTeam="Coritiba"
    awayTeam="Palmeiras"
    venue="Couto Pereira"
    city="Curitiba (PR)"
    broadcast="Prime Video"
    newsTitle="Jogo teve data e horário alterados"
    newsText="A partida foi remarcada para 22 de julho, às 19h30, no Couto Pereira. O Palmeiras chega como líder da competição, segundo a agenda divulgada para o retorno do campeonato."
    sourceUrl="https://ge.globo.com/pr/futebol/brasileirao-serie-a/noticia/2026/07/03/coritiba-x-palmeiras-tem-mudanca-de-data-e-horario-pela-serie-a-veja-os-detalhes.ghtml"
    sourceLabel="ge"
/>
